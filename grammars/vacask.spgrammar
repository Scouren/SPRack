# VACASK
#
# Checked against the VACASK manual and source at codeberg.org/arpadbuermen/VACASK
# b2c15511 (docs/verification.md section 1): docs/*.md, the parser
# lib/dfllexer.l and lib/dflparser.y, the source device lib/devvisrc.cpp, the
# built-in function table lib/context.cpp. Every rule here was load-checked
# with vacask at that revision.
#
# VACASK has no built-in device letters. Every instance names a model, every
# model names a builtin or a Verilog-A module, and a module must be loaded
# first. The `needs` sections below write that boilerplate when a device kind
# or a model family is used and hide it again when reading.
#
# Analyses and options live inside control ... endc. A DC sweep is a `sweep`
# line in front of an `op` analysis. Initial conditions and nodesets are
# parameters of the analyses (ic=, nodeset=), not statements.

dialect vacask

lexer
  case       sensitive
  title      yes
  comment    line "//"
  annotation "// *@"       # a line a tool reads, as a comment that keeps the `*@` of SPICE
  comment    tail "//"
  comment    block "/*" "*/"
  continue   trail "\"
  parens     token
  expr       bare
  values     idents
  vectors    comma
  scale      M=6 T=12 G=9 k=3 m=-3 u=-6 n=-9 p=-12 f=-15 a=-18
  # lib/dfllexer.l:643 and docs/input-numbers.md: K is kilo, x, X and meg mega.
  readscale  K=3 X=6 x=6 meg=6
  oddscale   mil=25.4e-6
  units      after-scale
end

preamble
  ground 0
end

# The SPICE-compatible modules, so a translated R or C keeps SPICE semantics.
# devices/CMakeLists.txt; module names in docs/dev-spice.md.
needs resistor
  load "spice/resistor.osdi"
  model resistor sp_resistor
end
needs capacitor
  load "spice/capacitor.osdi"
  model capacitor sp_capacitor
end
needs inductor
  load "spice/inductor.osdi"
  model inductor sp_inductor
end
needs diode
  load "spice/diode.osdi"
end
needs vsource
  model vsource vsource
end
needs isource
  model isource isource
end
# Builtins (docs/dev-builtin.md): each needs a model line, no load.
needs mutual
  model mutual mutual
end
needs vcvs
  model vcvs vcvs
end
needs vccs
  model vccs vccs
end
needs cccs
  model cccs cccs
end
needs ccvs
  model ccvs ccvs
end
# Shipped Verilog-A devices (docs/dev-vacask.md; devices/tline_ideal.va).
needs tline
  load "tline_ideal.osdi"
  model tline tline_ideal
end
# Model families: the OSDI file a model card of that family needs.
needs bjt
  load "spice/bjt.osdi"
end
needs vbic
  load "vbic_1p3_4t.osdi"
end
needs jfet
  load "spice/jfet1.osdi"
end
needs mesfet
  load "spice/mes1.osdi"
end
needs mos1
  load "spice/mos1.osdi"
end
needs mos2
  load "spice/mos2.osdi"
end
needs mos3
  load "spice/mos3.osdi"
end
needs bsim3
  load "spice/bsim3v3.osdi"
end
needs bsim4
  load "spice/bsim4v8.osdi"
end
needs bsimbulk
  load "bsimbulk106.osdi"
end
needs vdmos
  load "spice/vdmos.osdi"
end
needs psp103
  load "psp103v4.osdi"
end
# VACASK ships no BSIM-CMG: the module given with --provide (4.43).
needs bsimcmg
  load "{file}"
end

wrap "control" "endc" : options save op dc ac tran noise tf sp stb pss hb pac pnoise xf simctl alter

# A file carried inside the netlist (a Python post-processing script, say).
raw "embed" ">>>FILE" as embed : VACASK embeds a file (a post-processing script) in the netlist; SPICE dialects have no such statement, so save the file next to the netlist

# The terminal list is in parentheses, always (lib/dflparser.y:324,334).
block subckt
  open   "subckt" name "(" ports* ")" -inline
  inner  "parameters" {...params}
  close  "ends" [name]
end

# include "f" section=name reads only that section (docs/input-include.md).
block libsection
  open   "section" name
  close  "endsection"
end

# docs/cir-conditional.md; lib/dflparser.y:463-499.
block cond_if
  open   "@if" cond...
  close  "@end"
end

rule  cond_elif = "@elseif" cond...
rule  cond_else = "@else"
rule  param     = "parameters" {...params}
rule  global    = "global" nodes+
rule  lib       = "include" path { section=section! }
rule  include   = "include" path
# Parentheses only around parameters: `model d sp_diode ()` is a syntax error.
rule  model     = "model" name type [ "(" {...params} ")" ]
read  model     = "model" name type {...params}
rule  hdl       = "load" path
# lib/options.cpp:245-260 and :317; there is no trtol (tran_lteratio is not the same quantity).
# gshunt: "Shunt conductance from every potential node to ground"
# (docs/cmd-options-temp.md:21); measured, 1 mA into 1k gives 0.5 V with
# gshunt=1m and 1.0 V without (docs/verification.md 4.25).
rule  options   = "options" { reltol=reltol abstol=abstol vntol=vntol gmin=gmin gmin=gmindc temp=temp tnom=tnom scale=scale chgtol=chgtol tran_method="method" tran_maxord=maxord gshunt=gshunt ...params }
rule  save      = "save" signals+
read  opaque    = ( "ground" | "save" ) ...
# devices and outputs (b4)
# Control commands (docs/cmd-*.md) with no counterpart elsewhere: print
# shows circuit state, postprocess runs a script, abort sets what stops the
# run, elaborate builds the circuit.
rule  simctl    = ( cmd:"print" | cmd:"postprocess" | cmd:"abort" | cmd:"elaborate" ) args...

rule  op        = "analysis" name?op$# "op" { nodeset={nodeset} ...params }
# Nested sweep: the line written first is the outer loop (docs/cmd-sweep.md).
# An instance's own value is swept when parameter= is left out; a parameter
# of the netlist is one of the top-level instance, __topinst__
# (docs/cmd-elaboration.md); the temperature is an option.
rule  dc        = [ "sweep" _?outer$# ( { instance=="__topinst__" parameter="param2"! from=start2 to=stop2 step=step2 mode="sweep2" points=points2 } | { instance="src2"! from=start2 to=stop2 step=step2 mode="sweep2" points=points2 } | { option=="temp"!@var2:temp from=start2 to=stop2 step=step2 mode="sweep2" points=points2 } ) / ] "sweep" _?sweep$# ( { instance=="__topinst__" parameter="param"! from=start to=stop step=step mode="sweep" points=points values=[values] } | { instance="src"! parameter="devparam" from=start to=stop step=step mode="sweep" points=points values=[values] } | { option=="temp"!@var:temp from=start to=stop step=step mode="sweep" points=points values=[values] } ) / "analysis" name?dc$# "op" { nodeset={nodeset} }
rule  ac        = "analysis" name?ac$# "ac" { from=fstart to=fstop mode="sweep" points=points nodeset={nodeset} ...params }
# SPICE caps the time step at min(step, (stop-start)/50); VACASK only at
# (stop-start)/tran_minpts, 50 by default (lib/coretran.cpp:1467-1482), so
# without a maxstep it takes steps larger than SPICE's.
# start: "Time at which results start being recorded" (docs/cmd-analysis-tran.md:34).
rule  tran      = "analysis" name?tran$# "tran" { step=step stop=stop start=start maxstep=maxstep?$step icmode="skip_dc" ic={ic} nodeset={nodeset} ...params }
# out is a node or a node pair (docs/cmd-analysis-noise.md:38, cmd-analysis-dcxf.md:36).
rule  noise     = "analysis" name?noise$# "noise" { out=[out ref] in="src" from=fstart to=fstop mode="sweep" points=points nodeset={nodeset} ...params }
# docs/cmd-analysis-dcxf.md: the transfer function to `out` from every source.
# It reports tf() and zin() for every source by default (docs/cmd-analysis-dcxf.md:47-49):
# the source SPICE names is among them.
# A current as the output: out names the source's branch unknown, which
# getDiffNodePair (lib/core.cpp:451) finds as a node; measured equal to
# ngspice's .tf i(), sign included (docs/verification.md 4.29).
rule  tf        = "analysis" name?tf$# "dcxf" -src { out="iout:flow(br)"! nodeset={nodeset} ...params }
rule  tf        = "analysis" name?tf$# "dcxf" -src { out=[out ref] nodeset={nodeset} ...params }
rule  hb        = "analysis" name?hb$# "hb" { freq=[freqs] nharm=[harms] nodeset={nodeset} ...params }
# docs/cmd-analysis-acsp.md, cmd-analysis-acstb.md, cmd-analysis-pss.md.
rule  sp        = "analysis" name?sp$# "acsp" { from=fstart to=fstop mode="sweep" points=points nodeset={nodeset} ...params }
rule  stb       = "analysis" name?stb$# "acstb" { probe="probe"! from=fstart to=fstop mode="sweep" points=points nodeset={nodeset} ...params }
rule  pss       = "analysis" name?pss$# "pss" { tper=fund! tstab=tstab maxharm=harms ic={ic} nodeset={nodeset} ...params }

# analyses (b3). docs/cmd-analysis-pac.md, cmd-analysis-pnoise.md and
# cmd-analysis-acxf.md. pac and pnoise solve their own periodic steady
# state from the period on the same statement; one written from a Spectre or
# HSPICE pac, which leaves the period to the pss before it, has no form here.
rule  pac       = "analysis" name?pac$# "pac" { tper=fund! tstab=tstab maxharm=harms from=fstart to=fstop mode="sweep" points=points ...params }
rule  pnoise    = "analysis" name?pnoise$# "pnoise" { out="out" in="src" tper=fund! tstab=tstab maxharm=harms from=fstart to=fstop mode="sweep" points=points ...params }
rule  xf        = "analysis" name?xf$# "acxf" { out="out" from=fstart to=fstop mode="sweep" points=points ...params }
implied pnoise ref = 0
implied xf ref = 0
convert pac : fund = 1 / fund
convert pnoise : fund = 1 / fund
convert pac sweep=lin : points = points - 1
convert pnoise sweep=lin : points = points - 1
convert xf sweep=lin : points = points - 1
no pxf        : VACASK has no periodic transfer-function analysis (none among the analysis ids in include/an*.h)
no psp        : VACASK has no periodic S-parameter analysis; acsp is around the operating point
no dcmatch    : VACASK has no DC mismatch analysis
no trannoise  : VACASK runs transient noise as parameters of tran (noisefmax=, docs/cmd-analysis-trannoise.md); this grammar has no form that puts the HSPICE card there
no phasenoise : VACASK has no oscillator phase-noise analysis; its pnoise warns that it does not compute one (docs/cmd-analysis-pnoise.md)
no envelope   : VACASK has no envelope-following analysis
no qpss       : VACASK has no shooting quasi-periodic analysis; a multitone hb is its quasi-periodic steady state

# With a model of its own the device keeps it; these forms are write-only
# because any two-terminal instance would match them when reading.
write resistor  = name "(" pos neg ")" master { r=r ...params }
write capacitor = name "(" pos neg ")" master { c=c ...params }
write inductor  = name "(" pos neg ")" master { l=l ...params }
rule  resistor  = name "(" pos neg ")" "resistor" { r=r ...params }
rule  capacitor = name "(" pos neg ")" "capacitor" { c=c ...params }
rule  inductor  = name "(" pos neg ")" "inductor" { l=l ...params }
# docs/dev-builtin-mutual.md: no terminals, the inductors by name.
rule  mutual    = name "(" ")" "mutual" { k=k ind1="l1" ind2="l2" }
# docs/dev-builtin-src.md; parameters lib/devvisrc.cpp:27-72. mag and phase
# are the AC excitation; the sine phase is tdphase and its damping theta.
define wave = { dc=dc mag=acmag phase=acphase type="wave" val0=val0 val1=val1 delay=delay rise=rise fall=fall width=width period=period sinedc=sinedc ampl=ampl freq=freq theta=damp tdphase=sphase td2=td2 tau1=tau1 tau2=tau2 wave=[pwl] modindex=mdi modfreq=fsig ...params }
rule  vsource   = name "(" pos neg ")" "vsource" <wave>
rule  isource   = name "(" pos neg ")" "isource" <wave>
# docs/dev-builtin-behavioral.md: two terminals and no master name.
rule  bsource   = name! "(" pos neg ")" { v=v! ...params }
rule  bsource   = name! "(" pos neg ")" { i=i! ...params }
# docs/dev-builtin-vcvs.md and the three next to it. gain is the gain, the
# transconductance or the transresistance; a current is sensed in ctlinst.
rule  vcvs      = name "(" pos neg cpos cneg ")" "vcvs" { gain=gain ...params }
rule  vccs      = name "(" pos neg cpos cneg ")" "vccs" { gain=gm ...params }
rule  cccs      = name "(" pos neg ")" "cccs" { ctlinst="vsrc" gain=gain ...params }
rule  ccvs      = name "(" pos neg ")" "ccvs" { ctlinst="vsrc" gain=gain ...params }
rule  tline     = name "(" p1 n1 p2 n2 ")" "tline" { z0=z0 td=td f=f nl=nl ...params }
rule  instance  = name "(" nodes* ")" master {...params}

enum options method : trap=trap gear=gear2 euler=euler bdf=gear2
enum vsource wave : pulse=pulse sine=sine exp=exp pwl=pwl sffm=fm
enum isource wave : pulse=pulse sine=sine exp=exp pwl=pwl sffm=fm
enum tran skip_dc : yes=uic
implied noise ref = 0
implied tf ref = 0

# Initial conditions are an ic= list of tran and pss; nodesets a nodeset=
# list of every analysis (docs/cmd-analysis-tran.md, cmd-analysis-op.md).
move ic.values -> tran.ic
move ic.values -> pss.ic
move nodeset.values -> op.nodeset
move nodeset.values -> dc.nodeset
move nodeset.values -> ac.nodeset
move nodeset.values -> tran.nodeset
move nodeset.values -> noise.nodeset
move nodeset.values -> tf.nodeset
move nodeset.values -> sp.nodeset
move nodeset.values -> stb.nodeset
move nodeset.values -> pss.nodeset
move nodeset.values -> hb.nodeset

# An exp source starts at `delay`, and its td2 counts from there
# (lib/devvisrc.cpp:798); SPICE's TD2 is absolute.
convert vsource wave=exp : td2 = td2 - td1
convert vsource wave=exp : delay = td1
convert isource wave=exp : td2 = td2 - td1
convert isource wave=exp : delay = td1
# pss takes the period, not the frequency (docs/cmd-analysis-pss.md).
convert pss : fund = 1 / fund
# A linear sweep's points counts intervals: points+1 frequencies
# (docs/cmd-analysis-ac.md); SPICE counts the frequencies.
convert ac sweep=lin : points = points - 1
convert dc sweep=lin : points = points - 1
convert dc sweep2=lin : points2 = points2 - 1
convert noise sweep=lin : points = points - 1
convert sp sweep=lin : points = points - 1
convert stb sweep=lin : points = points - 1

# Source parameters whose VACASK default is not SPICE's (lib/devvisrc.cpp:90-140).
# Where the netlist has a .tran, SPICE's default is written out instead.
default vsource rise=0 wave=pulse : tran.step
default isource rise=0 wave=pulse : tran.step
default vsource fall=0 wave=pulse : tran.step
default isource fall=0 wave=pulse : tran.step
default vsource width=0 wave=pulse : tran.stop
default isource width=0 wave=pulse : tran.stop
# An exp source's delay is 0 when left out (measured); TD1 left out is the
# time step in ngspice 45.
implied vsource td1 = 0 wave=exp
implied isource td1 = 0 wave=exp
invalid vsource rise=0 wave=pulse : VACASK needs rise > 0 and defaults it to 1n; SPICE takes the time step
invalid isource rise=0 wave=pulse : VACASK needs rise > 0 and defaults it to 1n; SPICE takes the time step
invalid vsource fall=0 wave=pulse : a VACASK pulse without a fall time never falls; SPICE takes the time step
invalid isource fall=0 wave=pulse : a VACASK pulse without a fall time never falls; SPICE takes the time step
invalid vsource width=0 wave=pulse : a VACASK pulse without a width has no flat top; SPICE holds it to the end of the run
invalid isource width=0 wave=pulse : a VACASK pulse without a width has no flat top; SPICE holds it to the end of the run
invalid vsource freq=0 wave=sine : VACASK's default frequency is 1k; SPICE's is 1/TSTOP
invalid isource freq=0 wave=sine : VACASK's default frequency is 1k; SPICE's is 1/TSTOP
invalid vsource tau1 wave=exp : VACASK's default rise time constant is 0; SPICE's is the time step
invalid isource tau1 wave=exp : VACASK's default rise time constant is 0; SPICE's is the time step
invalid vsource td2 wave=exp : VACASK needs td2 > delay; SPICE's default is TD1 plus the time step
invalid isource td2 wave=exp : VACASK needs td2 > delay; SPICE's default is TD1 plus the time step
invalid vsource tau2 wave=exp : VACASK's default fall time constant is 0; SPICE's is the time step
invalid isource tau2 wave=exp : VACASK's default fall time constant is 0; SPICE's is the time step
invalid vsource freq=0 wave=sffm : VACASK's default carrier frequency is 1k; SPICE's is 1/TSTOP
invalid isource freq=0 wave=sffm : VACASK's default carrier frequency is 1k; SPICE's is 1/TSTOP
invalid vsource mdi wave=sffm : VACASK's default modulation index is 0.5; SPICE's is 0
invalid isource mdi wave=sffm : VACASK's default modulation index is 0.5; SPICE's is 0
invalid vsource fsig=0 wave=sffm : VACASK's default modulating frequency is 1k; SPICE's is 1/TSTOP
invalid isource fsig=0 wave=sffm : VACASK's default modulating frequency is 1k; SPICE's is 1/TSTOP

# lib/dflparser.y:344-428: no function-definition production.
no lossyline : VACASK has no lossy line device, built in or shipped (devices/ has tline_ideal only)
no ctlsrc  : VACASK's controlled sources are the four linear builtins; a polynomial or table is a behavioural source's expression
no relay   : VACASK has no relay or switch device, built in or shipped
no func    : VACASK netlists have no user-defined functions
# No measure command among docs/cmd-*.md.
no measure : VACASK has no measure statement; results are post-processed in Python
# docs/cmd-print.md: print shows expressions and circuit state.
no print   : VACASK's print shows expressions and circuit state; analysis results go to raw files
# Analysis ids in include/an*.h: op ac noise dcxf hb dcinc acxf tran acstb pss pnoise acsp hbnoise pac hbac.
no pz      : VACASK has no pole-zero analysis
no disto   : VACASK has no .DISTO analysis; use hb
no four    : VACASK has no .FOUR statement; use hb or post-process the transient result
no sens    : VACASK has no sensitivity analysis
# docs/dev-builtin.md lists seven builtins and no switch; devices/ ships none.
no vswitch : VACASK has no switch device, built in or shipped; it has to be a user Verilog-A module (demo/sc/swtest.sim loads vsw.va)
no cswitch : VACASK has no switch device, built in or shipped; it has to be a user Verilog-A module
no xspice  : XSPICE code models are ngspice's; VACASK has no such element
no verilog : VACASK has no digital Verilog co-simulation; its devices are Verilog-A modules compiled with OpenVAF

# VACASK (b2c1551) names the module it synthesizes after the instance but
# looks it up in lower case: an instance name with capitals is not found, so
# the name is written in lower case (`name!`).
caveat hdl path : VACASK loads compiled OSDI files, or compiles a .va file it is given
caveat save signals : in VACASK's ac, noise, acxf and dcinc analyses v() saves the operating point; the small-signal value is dv() (docs/cmd-analysis-ac.md)
# Observed on decks written for it: the operating point fails (homotopy
# gives up) on nodes with no DC path to ground and on any loop of voltage
# sources and inductors, where ngspice gets through with its transient
# operating point. A transient with icmode="uic" needs no DC path and
# integrates through inductors; a loop of voltage sources fails it too.
# A transient without it solves the operating point first: tran is listed.
requires dc-path   error [op dc ac noise tf pz sens disto sp stb xf dcmatch hb pss pac pnoise pxf psp qpss phasenoise tran trannoise envelope] : VACASK's operating point fails on it, where ngspice gets through with its transient operating point; a large resistor to ground gives one
requires no-vloop  error : VACASK's operating point fails on it
requires no-vlloop error : VACASK's operating point fails on it, where ngspice gets through with its transient operating point
requires no-lloop  error : VACASK's operating point fails on it, where ngspice and Xyce solve it

caveat tran skip_dc : icmode="uic" starts every node without an ic at 0, so the first time point differs from SPICE's UIC
caveat tf out : dcxf reports tf(), zin() and yin() for every independent source; SPICE's output resistance has no counterpart
caveat tf iout : dcxf reports tf(), zin() and yin() for every independent source; SPICE's output resistance has no counterpart
caveat tf src : dcxf reports tf() and zin() for every independent source, the one SPICE names among them; it is not named
caveat pac fstart : VACASK's pac is driven by each source's spur, smag and sphase; the ac mag and phase have no effect there (docs/cmd-analysis-pac.md)
caveat sp sweep : acsp names its ports in ports=["vsrc", "rseries", ...]; SPICE's portnum and z0 on a source have no VACASK form
# A port is a structure here, not a value: a source, a series resistor of
# the port impedance and a node between them, named in acsp's ports=.
# Written so it would add an element and a node to the circuit; until a
# two-port deck is measured against ngspice (docs/verification.md 4.34),
# the translation says how to rebuild it instead (#49).
no vsource portnum : a VACASK acsp port is a voltage source and a series resistor of the port impedance, named as a pair in the analysis's ports=[...] in port order; rebuild it by hand: the source to a node of its own, a resistor of z0 from there to the port node, and the two names in ports=
no vsource z0 : the port impedance is a series resistor beside the source in VACASK, named with it in acsp's ports=[...]; rebuild the port by hand as the source to a node of its own and a resistor of z0 from there to the port node
# docs/cmd-analysis-noise.md "Output": onoise, gain and n(...) per frequency.
caveat noise out : VACASK writes the output noise as a power density with the power gain (input noise is onoise/gain) and no integrated totals; SPICE writes V/sqrt(Hz) spectra and the integrated noise
# Instance parameters, by ngspice name. Every device takes $mfactor for m
# (docs/cir-mfactor.md; "Parameter m was replaced with builtin Verilog-A
# parameter $mfactor" in each devices/spice/*.va). The rest are the
# type="instance" parameters of devices/spice/*.va and lib/devvisrc.cpp:27-72;
# ic and off were removed from the modules ("Initial conditions should be set
# via the simulator's initial conditions mechanism"), resistor ac has none.
params resistor
  same bv_max dtemp l scale tc2 tce temp w
  tc1   = tc1 tc
  noisy = noisy noise
  m     = $mfactor
end
params capacitor
  same bv_max dtemp l scale tc1 tc2 temp w
  m = $mfactor
end
# What VACASK's capacitor does not take, other devices say, as measured in
# ngspice 45 and VACASK b2c1551 (docs/verification.md 4.16).
# A charge: a behavioural source whose current is ddt of it, times m.
rewrite capacitor q
  when   bsource ddt
  become bsource name={name} pos={pos} neg={neg} i=[{m}*]ddt({q})
  loss   : capacitor '{name}': {what} has no place on the behavioural source a capacitor given by its charge is written as for {to}
  oneway : capacitor '{name}': {to}'s capacitor takes no charge (q=); it is written as a behavioural source whose current is {i}, which reads back as that source
end
# An initial voltage: the capacitor to a node of its own, and from there to
# its second node a DC source of that voltage. With UIC the capacitor starts
# at 0 and the pair at ic; at an operating point and in AC the source is the
# short it adds. ngspice lets the capacitor's ic win over an .ic on one of
# its nodes; the source in series adds the two.
rewrite capacitor ic
  when   vsource
  keep   neg={name}__ic
  add    vsource name=V{name}__ic pos={name}__ic neg={neg} dc={ic}
  clash  ic.values pos neg : capacitor '{name}': ic={ic}, and an .ic sets node {node} too; {from} takes the capacitor's, and the source in series that says it for {to} adds the two
  oneway : capacitor '{name}': {to}'s capacitor takes no initial voltage (ic={ic}); it is written to node {name}__ic, with a DC source of {ic} from there to {neg}, which reads back as the two
end
params inductor
  same dtemp nt scale tc1 tc2 temp
  m = $mfactor
end
params isource
  m = $mfactor
end
params diode
  same area dtemp l lm lp perim pj temp w wm wp
  m = $mfactor
end
params bjt
  same area areab areac dtemp temp
  m = $mfactor
end
params jfet
  same area dtemp temp
  m = $mfactor
end
# MOSFET modules differ in their instance parameters (bsim4v8.va renames
# some to instance_*); only m is renamed, the rest are copied as written.
params mosfet
  m = $mfactor
  same ...
end
# Model parameters the shipped modules refuse ("Parameter ... not found").
# devices/spice/bsim3v3.va has no version; bsim4v8.va:164 declares it a string.
# A dropped version is a warning: VACASK still simulates the card, with the
# BSIM3/BSIM4 version it ships. A dropped JFET level 2 is an error: sp_jfet1
# would simulate a level 2 (Parker-Skellern) card as the level 1 model.
noparam bsim3 version warning : sp_bsim3v3 implements BSIM3 3.3.0 only and has no version parameter
noparam bsim4 version warning : VACASK ships BSIM4 4.8 only (sp_bsim4v8.va:3873-3882) and takes version as a string; SPICE selects BSIM4 4.5 to 4.8 by its number
# devices/spice/jfet1.va has no level; jfet2.va is a module with no family here.
noparam jfet level=1 warning : sp_jfet1 is the level 1 JFET and has no level parameter; the card is simulated as written
noparam jfet level error : sp_jfet1 is the level 1 JFET and has no level parameter; the level 2 model (spice/jfet2.osdi) has no family in the IR
# devices/spice/bjt.va has no level either: VACASK b2c1551 refuses
# `model q sp_bjt (type=1 level=1)` with "Parameter 'level' not found".
noparam bjt level=1 warning : sp_bjt is the level 1 (Gummel-Poon) BJT and has no level parameter; the card is simulated as written
# BSIM-CMG modules declare no version (107.0.0, 108.0.0 and 112.1.0
# sources); a version 107 card on the 107.0.0 module gives Xyce's level 107
# to 9 digits, another version was not measured (docs/verification.md 4.43).
noparam bsimcmg version=107 warning : the module given has no version parameter; BSIM-CMG 107.0.0 compiled with openvaf-r (tools/bsimcmg-osdi.sh) runs version 107 cards as Xyce's level 107 does (docs/verification.md 4.43), which module was given is not checked
noparam bsimcmg version error : the module given has no version parameter, and only version 107 cards were measured against a built-in BSIM-CMG (docs/verification.md 4.43)
# docs/cmd-options-op.md "Nodesets": op_nsiter=1, nr_nsforce=10.
caveat op     nodeset : VACASK pulls toward a nodeset only during its first Newton iteration (op_nsiter); SPICE holds it until a first solution converges, so a bistable circuit may settle in the other state
caveat dc     nodeset : VACASK pulls toward a nodeset only during its first Newton iteration (op_nsiter); SPICE holds it until a first solution converges, so a bistable circuit may settle in the other state
caveat ac     nodeset : VACASK pulls toward a nodeset only during its first Newton iteration (op_nsiter); SPICE holds it until a first solution converges, so a bistable circuit may settle in the other state
caveat tran   nodeset : VACASK pulls toward a nodeset only during its first Newton iteration (op_nsiter); SPICE holds it until a first solution converges, so a bistable circuit may settle in the other state
caveat noise  nodeset : VACASK pulls toward a nodeset only during its first Newton iteration (op_nsiter); SPICE holds it until a first solution converges, so a bistable circuit may settle in the other state
caveat cond_if cond : a VACASK @if branch may hold instances, models and nested blocks, but not parameters (lib/dflparser.y:467-499)

# statistics
# A parameter of the netlist varies through agauss(), gauss(), aunif() or unif() in its
# definition; a statistics block's process variations are written that way
# when the varied parameter is defined in the same file.
no statistics : VACASK has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no statgroup : VACASK has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no vary : VACASK has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no correlate : VACASK has no statement that correlates two random parameters
no montecarlo : VACASK has no Monte Carlo analysis
# A library file has no wrapper around its sections; the name is carried
# as a comment.
block library
  open   "//" "library" name
  close  "//" "endlibrary"
end
caveat library name : VACASK has no library wrapper around its sections; it is written as a comment
caveat subckt inline : VACASK has no inline subcircuits; the subcircuit is written as an ordinary one, so the devices in it are named one level deeper

signals
  v = "v(%)"
  i = "i(%)"
end

# lib/context.cpp:37-116 and docs/expr-functions.md. log is natural, as ln.
# sgn is left out: VACASK's sgn(0) is 1, SPICE's is 0 (include/rpnfunctor.h:300).
functions
  same abs min max sqrt exp pow floor ceil sin cos tan asin acos atan atan2 sinh cosh tanh asinh acosh atanh hypot fmod
  same agauss gauss aunif unif v i
  # ddt: the time derivative, in a behavioural source (docs/verification.md 4.16).
  same ddt
  ln    = ln log
  log10 = log10
  sign2 = sign
  int   = integer
end

# docs/expr-special.md: $temp everywhere, $abstime only in a behavioural source.
variables
  temper = $temp
  time   = $abstime
end

# lib/dfllexer.l:722 (**) and :749-750 (^ is bitwise exclusive-or).
operators
  pow "**"
  xor "^"
  ternary "?"
end

# A netlist may give a module any model name (`model r sp_resistor`);
# instances of that model are still resistors. type=1 is n/npn, -1 p/pnp
# (devices/spice/bjt.va:89, mos1.va:112, jfet1.va:95, mes1.va:76,
# bsim3v3.va:566, bsim4v8.va:1038; bsimbulk106.va:706; vbic_1p3.va:302).
models
  resistor   = sp_resistor | resistor
  capacitor  = sp_capacitor | capacitor
  inductor   = sp_inductor | inductor
  diode      = sp_diode
  vsource    = vsource
  isource    = isource
  bjt npn    = sp_bjt type=1
  bjt pnp    = sp_bjt type=-1
  vbic npn   = vbic13_4t type=1 | vbic13 type=1
  vbic pnp   = vbic13_4t type=-1 | vbic13 type=-1
  jfet n     = sp_jfet1 type=1
  jfet p     = sp_jfet1 type=-1
  mesfet n   = sp_mes1 type=1
  mesfet p   = sp_mes1 type=-1
  mos1 n     = sp_mos1 type=1
  mos1 p     = sp_mos1 type=-1
  mos2 n     = sp_mos2 type=1
  mos2 p     = sp_mos2 type=-1
  mos3 n     = sp_mos3 type=1
  mos3 p     = sp_mos3 type=-1
  bsim3 n    = sp_bsim3v3 type=1 | bsim3 type=1
  bsim3 p    = sp_bsim3v3 type=-1 | bsim3 type=-1
  bsim4 n    = sp_bsim4v8 type=1 | bsim4 type=1
  bsim4 p    = sp_bsim4v8 type=-1 | bsim4 type=-1
  bsimbulk n = bsimbulk type=1
  bsimbulk p = bsimbulk type=-1
  vdmos      = sp_vdmos
  psp103 n   = psp103va type=1
  psp103 p   = psp103va type=-1
  # The module given with --provide (4.43); polarity is DEVTYPE, as ngspice's.
  bsimcmg n  = bsimcmg devtype=1 provided
  bsimcmg p  = bsimcmg devtype=0 provided
end

# sweeps
no step : VACASK has no sweep of the whole netlist; a sweep line applies only to the one analysis after it (docs/cmd-sweep.md)
no data : VACASK has no data tables; a sweep lists its points in values= (docs/cmd-sweep.md)
# lib/coresweep.cpp:45-63 and 130-143: points are counted with ceil() and no tolerance.
caveat dc step : VACASK counts a stepped sweep's points with no rounding tolerance, so a stop a whole number of steps away may lose its last point (0.2 to 0.9 by 0.005 gives 140 points, not 141)
caveat ac points : VACASK counts points per decade with no rounding tolerance and spaces a span that is not a whole number of steps evenly up to the stop, not on SPICE's per-decade grid
caveat noise points : VACASK counts points per decade with no rounding tolerance and spaces a span that is not a whole number of steps evenly up to the stop, not on SPICE's per-decade grid
# alter (c2)
# The control block runs in order: `alter` on the top-level instance changes
# its parameters (docs/cmd-alter.md), `options temp=` the temperature, and
# the analyses written again after it see both, on top of earlier changes
# (run in b2c1551). Only parameters and the temperature are written so.
write alter     = [ "alter" 'instance("__topinst__")' ( keys ~"=" vals )* / ] [ "options" { temp=temp } ]
rerun alter

# Measured with a 1k resistor of tc1=0.01: 27 each, and independent.
implied options tnom = 27
implied options temp = 27
# No step-cap option: HSPICE's DELMAX is the tran maximum step (ngspice.spgrammar).
move options.delmax -> tran.maxstep oneway

# A model card's parameters that were measured, by ngspice name. sp_resistor's
# NARROW and SHORT, with RSH=1000 at five L and W: ngspice's formula, and DW
# and DLR name them too (docs/verification.md 4.13). sp_inductor's IND, the
# inductance of a line that gives none, and its TC1 (docs/verification.md 9.2).
modelparams resistor
  narrow = narrow dw
  short  = short dlr
end
modelparams inductor
  same ind tc1
end
noparam inductor lscale error : Xyce's inductor card L multiplies the line's inductance (docs/verification.md 9.1); VACASK's card has no such multiplier, so the inductance is the line's alone
# Every parameter a model card of the module a family is written as takes
# (the OSDI descriptor VACASK loads: model and instance parameters with their
# aliases, include/osdifile.h modelParameterIndex), under the canonical
# (ngspice) name where ngspice has another: made by
# `tools/param_lists.py vacask <lib/vacask/mod>` (docs/verification.md 4.23).
# A name not listed is a loss VACASK would refuse ("Parameter ... not found").
modelparams diode only
  same temp dtemp area w l lm lp wm wp level rs rsw
  same trs2 n ns tt ttt1 ttt2 tm1 tm2 mjsw ikr ikp model_area
  same model_pj tlev tlevc eg gap1 gap2 xti ctp tphp jtun jtunsw ntun
  same xtitun keg kf af fc fcs isr nr vp qpscale fv_max bv_max
  same id_max te_max pd_max model_lm model_lp model_wm model_wp xom xoi xm xp xw
  pj = pj perim
  is = is js
  jsw = jsw isw
  tnom = tnom tref
  trs = trs trs1
  cjo = cjo cj0 cj
  vj = vj pb
  m = m mj
  cjp = cjp cjsw
  php = php vjsw
  ikf = ikf ik
  nbv = nbv nz
  cta = cta ctc
  tpb = tpb tvj
  bv = bv vb vrb var
  ibv = ibv ib
  tbv1 = tcv tbv1
end
