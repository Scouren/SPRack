# ESPice
#
# Written from ESPice's own documentation (docs/using/dialects.md,
# analyses.md, devices.md in the ESPice repository). ESPice reads the ngspice
# dialect (ngspice 45) plus HSPICE cards that no ngspice spelling collides
# with, so this file is ngspice's with these differences:
#
# - Verilog-A source is loaded with `.hdl "file.va"` and instantiated with an
#   N card; ESPice compiles the source itself and never loads OSDI binaries
#   (`pre_osdi` is an error there). `.control` blocks are skipped with a
#   warning, so they are still kept verbatim.
# - `.verilog "design.v"` loads a digital Verilog design (reference.md).
# - `.pss f0 [points]`, `.hb TONES= NHARMS=` (HSPICE's form) and
#   `.stb Vprobe dec|oct|lin N fstart fstop` exist.
# - The model levels follow ESPice's tables (ngspice's, plus BSIM-CMG 72,
#   BSIM-BULK 77 and PSP 103 at 1040).
#
# The ESPice HSPICE cards outside the vocabulary (.lstb, ...)
# and its own .pac, .pnoise, .pxf, .qpss, .envelope, .matex are not here;
# they read as untranslated lines.

dialect espice

lexer
  case      insensitive
  title     yes
  comment   line "*"
  comment   tail "$" ";" "//"
  continue  lead "+"
  continue  trail "\\"
  parens    space
  expr      "{" "}"
  expr      "'" "'"
  expr      after-equals
  values    strict
  scale     meg=6 t=12 g=9 k=3 m=-3 u=-6 n=-9 p=-12 f=-15 a=-18
  oddscale  mil=25.4e-6
  units     ignore
  end       ".end"
end

raw ".control" ".endc"

block subckt
  open   ".subckt" name ports* ( {...params} | "params:" {...params} ) -inline
  close  ".ends" [name]
end

block libsection
  open   ".lib" name
  close  ".endl" [name]
end

block cond_if
  open   ".if" cond...
  close  ".endif"
end

rule  func      = ".func" name ~"(" args* ~")" expr
read  func      = ".func" name args* "=" expr
read  func      = ".param" name args+ "=" expr
rule  param     = ".param" {...params}
read  param     = ".params" {...params}
rule  cond_elif = ".elseif" cond...
rule  cond_else = ".else"
rule  global    = ".global" nodes+
rule  include   = ".include" path
read  include   = ".inc" path
rule  lib       = ".lib" path section
# Model cards may carry bare flags (vdmos pchan, ltra steplimit).
rule  model     = ".model" name type {...params?}
rule  hdl       = ".hdl" path
rule  verilog   = ".verilog" path

rule  options   = ".temp" temp
rule  options   = ".options" { temp=temp reltol=reltol abstol=abstol vntol=vntol gmin=gmin gmin=gmindc tnom=tnom scale=scale method=method maxord=maxord chgtol=chgtol trtol=trtol gshunt=gshunt cshunt=cshunt delmax=delmax ...params? }
read  options   = ".option" { temp=temp reltol=reltol abstol=abstol vntol=vntol gmin=gmin gmin=gmindc tnom=tnom scale=scale method=method maxord=maxord chgtol=chgtol trtol=trtol gshunt=gshunt cshunt=cshunt delmax=delmax ...params? }
rule  save      = ".save" signals+
rule  print     = ( style:".print"=print | style:".plot"=plot | style:".probe"=probe ) [analysis] signals+
rule  ic        = ".ic" { v(*)=values }
rule  nodeset   = ".nodeset" { v(*)=values }

rule  resistor  = name~"R" pos neg [r] [master] { r=r ...params }
rule  capacitor = name~"C" pos neg [c] [master] { c=c ...params }
rule  inductor  = name~"L" pos neg [l] { l=l ...params }
rule  mutual    = name~"K" l1 l2 k
# The waveform of a V or I source; vsource and isource share these slots.
define wave = ( wave:"pulse" ~"(" val0 val1 [delay [rise [fall [width [period [count]]]]]] ~")" | wave:"sin"=sine ~"(" sinedc?$dc ampl [freq [delay [damp [sphase]]]] ~")" | wave:"exp" ~"(" val0 val1 [td1 [tau1 [td2 [tau2]]]] ~")" | wave:"pwl" ~"(" pwl+ ~")" | wave:"sffm" ~"(" sinedc ampl fsig?0 mdi?0 freq [delay [mphase [sphase]]] ~")" | wave:"sffm" ~"(" sinedc ampl [fsig [mdi]] ~")" | wave:"am" ~"(" sinedc?0 val0?0 ampl fsig freq [delay [mphase [sphase]]] ~")" | wave:"trnoise" ~"(" wargs+ ~")" | wave:"trrandom" ~"(" wargs+ ~")" )
rule  vsource   = name~"V" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] [ "distof1" distof1 [distof1ph] ] [ "distof2" distof2 [distof2ph] ] [ "portnum" portnum [ "z0" z0 ] ] {...params}
read  vsource   = name~"V" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] [ "distof1" distof1 [distof1ph] ] [ "distof2" distof2 [distof2ph] ] [ "portnum" portnum [ "z0" z0 ] ] {...params}
read  vsource   = name~"V" pos neg "ac" acmag [acphase] "dc" dc [ "distof1" distof1 [distof1ph] ] [ "distof2" distof2 [distof2ph] ] [ "portnum" portnum [ "z0" z0 ] ] {...params}
# b4: `dc=` as a key, and `ac` with no magnitude, which is 1.
read  vsource   = name~"V" pos neg [ { dc=dc! } ] [ ( "ac" acmag [acphase] | acmag:"ac"=1 ) ] [ <wave> ] {...params}
rule  isource   = name~"I" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] [ "distof1" distof1 [distof1ph] ] [ "distof2" distof2 [distof2ph] ] [ "portnum" portnum [ "z0" z0 ] ] {...params}
read  isource   = name~"I" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] [ "distof1" distof1 [distof1ph] ] [ "distof2" distof2 [distof2ph] ] [ "portnum" portnum [ "z0" z0 ] ] {...params}
read  isource   = name~"I" pos neg "ac" acmag [acphase] "dc" dc [ "distof1" distof1 [distof1ph] ] [ "distof2" distof2 [distof2ph] ] [ "portnum" portnum [ "z0" z0 ] ] {...params}
read  isource   = name~"I" pos neg [ { dc=dc! } ] [ ( "ac" acmag [acphase] | acmag:"ac"=1 ) ] [ <wave> ] {...params}
rule  bsource   = name~"B" pos neg { v=v i=i ...params }
# The HSPICE and PSpice spellings of a behavioural source, which ngspice also reads.
rule  bsource   = name~"E" pos neg { vol=v! }
rule  bsource   = name~"G" pos neg { cur=i! }
read  bsource   = name~"E" pos neg { value=v! }
read  bsource   = name~"G" pos neg { value=i! }
rule  vcvs      = name~"E" pos neg cpos cneg gain
rule  vccs      = name~"G" pos neg cpos cneg gm
rule  cccs      = name~"F" pos neg vsrc gain
rule  ccvs      = name~"H" pos neg vsrc gain
rule  diode     = name~"D" pos neg master [area] { area=area ...params? }
rule  bjt       = name~"Q" c b e [s] master [area] { area=area ...params? }
# With a substrate node and a thermal node (self-heating models).
rule  bjt       = name~"Q" c b e s tj master [area] { area=area ...params? }
rule  mosfet    = name~"M" d g s b master {...params}
# Three-terminal power MOSFETs (VDMOS) have no bulk node.
rule  mosfet    = name~"M" d g s master {...params}
rule  jfet      = name~"J" d g s master [area] {...params}
rule  mesfet    = name~"Z" d g s master [area] {...params}
rule  vswitch   = name~"S" pos neg cpos cneg master [ ( state:"on" | state:"off" ) ]
rule  cswitch   = name~"W" pos neg vsrc master [ ( state:"on" | state:"off" ) ]
rule  tline     = name~"T" p1 n1 p2 n2 { z0=z0 td=td f=f nl=nl ...params }
rule  device    = name~"N" nodes+ master {...params}
# ngspice accepts the PSpice-style params: keyword but does not need it.
read  instance  = name~"X" nodes+ master "params:" {...params}
rule  instance  = name~"X" nodes+ master {...params}

rule  op        = ".op"
rule  tf        = ".tf" "v" ~"(" out [ ~"," ref ] ~")" src
# HSPICE's .DC forms as well as ngspice's (see hspice.spgrammar).
define what  = ( var:"temp" | src | param )
# A parameter is swept only on its own (a nested sweep with one is refused).
define what2 = ( var2:"temp" | src2 )
define range = ( ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points start stop | "poi" _?$+values ( values )+ | start stop step )
read  dc        = ".dc" <what> "poi" _ ( values )+ <what2> ( sweep2:"dec" | sweep2:"oct" | sweep2:"lin" ) points2 start2 stop2
read  dc        = ".dc" <what> "poi" _ ( values )+ <what2> start2 stop2 step2
rule  dc        = ".dc" <what> <range>
rule  dc        = ".dc" ( var:"temp" | src ) <range> <what2> ( ( sweep2:"dec" | sweep2:"oct" | sweep2:"lin" ) points2 start2 stop2 | start2 stop2 step2 )
read  dc        = ".dc" <what> { start=start! stop=stop! step=step! }
rule  dc        = ".dc" { data=data! }
rule  ac        = ".ac" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  tran      = ".tran" step?'$stop/1000' stop [ start?0 [maxstep] ] [ skip_dc:"uic"=yes ]
rule  noise     = ".noise" "v" ~"(" out [ ~"," ref ] ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop [interval]
rule  pz        = ".pz" in_pos in_neg out_pos out_neg ( transfer:"cur" | transfer:"vol" ) ( find:"pol" | find:"zer" | find:"pz" )
rule  sens      = ".sens" out
rule  disto     = ".disto" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop [f2overf1]
rule  four      = ".four" freq signals+
rule  sp        = ".sp" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  stb       = ".stb" probe ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  pss       = ".pss" fund [points]
rule  hb        = ".hb" "tones" ~"=" ( freqs )+ [ "nharms" ~"=" ( harms )+ ] {...params}
read  hb        = ".hb" { tones=freqs! nharms=harms ...params }

implied noise ref = 0
implied tf ref = 0
enum options method : trap=trap gear=gear bdf=gear
enum dc var : temp=temp
# Measured with a 1k resistor of tc1=0.01: 27 each, and independent.
implied options tnom = 27
implied options temp = 27
# SFFM(VO VA FM MDI FC [TD [PHASEM [PHASEC]]]): the modulating frequency is
# third and the carrier fifth, the reverse of HSPICE and Xyce (measured).
caveat vsource mdi : ESPice limits the SFFM modulation index to the carrier over the modulating frequency
caveat isource mdi : ESPice limits the SFFM modulation index to the carrier over the modulating frequency
no xspice : ESPice has no XSPICE code models; a digital block is a Verilog design loaded with .verilog and instantiated with an N card
# analyses (b3). ESPice reads these HSPICE cards as HSPICE writes them
# (docs/using/dialects.md). Its own .pac, .pnoise, .pxf, .qpss, .envelope,
# .matex and .acxf cards are not here (PLAN.md: ESPice-only syntax is out
# of scope), so the shooting forms have no rule.
rule  pac        = engine:".hbac"=hb ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  pnoise     = engine:".hbnoise"=hb "v" ~"(" out [ ~"," ref ] ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  pxf        = engine:".hbxf"=hb "v" ~"(" out [ ~"," ref ] ~")" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  psp        = engine:".hblin"=hb ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop {...params}
rule  dcmatch    = ".dcmatch" "v" ~"(" out [ ~"," ref ] ~")"
rule  trannoise  = ".trannoise" "v" ~"(" out [ ~"," ref ] ~")" { method=method samples=samples seed=seed fmin=fmin fmax=fmax scale=scale time=time ...params }
rule  phasenoise = ".phasenoise" "v" ~"(" out [ ~"," ref ] ~")" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop {...params}
implied pnoise ref = 0
implied pxf ref = 0
implied dcmatch ref = 0
implied trannoise ref = 0
implied phasenoise ref = 0
no xf       : ESPice's own .acxf card is outside this grammar (ESPice-only syntax)
no envelope : ESPice's own .envelope card is outside this grammar (ESPice-only syntax)
no qpss     : ESPice's own .qpss card is outside this grammar (ESPice-only syntax)


caveat tran skip_dc : UIC skips the DC solve and starts from .ic and ic= values, and ESPice uses .ic only under UIC; other simulators seed the first time point differently
caveat tran step : the first .tran number is a suggested step for ESPice, as for ngspice, not a hard limit
caveat hdl path=*.osdi : ESPice compiles Verilog-A source named by .hdl and never loads a compiled OSDI file

# How this dialect writes the things a simulator can record.
# statistics
# A parameter of the netlist varies through agauss(), gauss(), aunif() or unif() in its
# definition; a statistics block's process variations are written that way
# when the varied parameter is defined in the same file.
no statistics : ESPice has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no statgroup : ESPice has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no vary : ESPice has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no correlate : ESPice has no statement that correlates two random parameters
no montecarlo : ESPice has no Monte Carlo statement; as in ngspice, a run is a loop in a .control script
# A library file has no wrapper around its sections; the name is carried
# as a comment.
block library
  open   "*" "library" name
  close  "*" "endlibrary"
end
caveat library name : ESPice has no library wrapper around its sections; it is written as a comment
caveat subckt inline : ESPice has no inline subcircuits; the subcircuit is written as an ordinary one, so the devices in it are named one level deeper

signals
  vdiff = "v(%,%)"
  v     = "v(%)"
  i     = "i(%)"
  vdb   = "vdb(%)"
  vm    = "vm(%)"
  vp    = "vp(%)"
  vr    = "vr(%)"
  vi    = "vi(%)"
  all   = "all"
  # b4: currents in dB, phase, magnitude, real and imaginary part are
  # functions of i() (there is no idb()); vm#branch is i(vm); a terminal
  # current is a device's @-parameter; an expression goes in as written.
  idb   = "db(i(%))"
  ip    = "ph(i(%))"
  im    = "mag(i(%))"
  ir    = "real(i(%))"
  ii    = "imag(i(%))"
  i     = "%#branch"
  ix    = "@%1[i%2]"
  expr  = "%"
end
functions
  same abs min max sqrt exp pow pwr floor ceil int sgn sin cos tan asin acos atan sinh cosh tanh
  same limit agauss gauss aunif unif v i
  same nint sqr asinh acosh atanh
  ln    = ln log
  log10 = log10
  if    = ternary_fcn
end

variables
  same temper time hertz
end

operators
  pow "**" "^"
  ternary "?"
  not "!"
  mod "%"
end

# As ngspice: measured with ngspice 45 on decks written for it (.param and a B source).
differs pow    : a negative base loses its sign, in .param and B sources alike: (-2)**3 is 8
differs pwr    : in .param the sign of a negative base is dropped (pwr(-2,3) is 8); B sources keep it (-8)
differs int    : only .param expressions have int(); a B source refuses it
differs negpow : in .param a minus right after another operator binds before the power: 1+-2**2 is 5, not -3

models
  resistor   = r
  capacitor  = c
  inductor   = l
  diode      = d
  bjt npn    = npn
  bjt pnp    = pnp
  vbic npn   = npn level=4 | npn level=9
  vbic pnp   = pnp level=4 | pnp level=9
  hicum2 npn = npn level=8
  hicum2 pnp = pnp level=8
  jfet n     = njf
  jfet p     = pjf
  mesfet n   = nmf
  mesfet p   = pmf
  hfet n     = nhfet
  hfet p     = phfet
  mos1 n     = nmos level=1 | nmos !level
  mos1 p     = pmos level=1 | pmos !level
  mos2 n     = nmos level=2
  mos2 p     = pmos level=2
  mos3 n     = nmos level=3
  mos3 p     = pmos level=3
  bsimcmg n  = nmos level=72
  bsimcmg p  = pmos level=72
  bsimbulk n = nmos level=77
  bsimbulk p = pmos level=77
  psp103 n   = nmos level=1040
  psp103 p   = pmos level=1040
  bsim3 n    = nmos level=8 | nmos level=49
  bsim3 p    = pmos level=8 | pmos level=49
  bsim4 n    = nmos level=14 | nmos level=54
  bsim4 p    = pmos level=14 | pmos level=54
  bsimsoi n  = nmos level=10 | nmos level=58
  bsimsoi p  = pmos level=10 | pmos level=58
  hisim2 n   = nmos level=68
  hisim2 p   = pmos level=68
  hisimhv n  = nmos level=73
  hisimhv p  = pmos level=73
  vdmos      = vdmos
  vswitch    = sw
  cswitch    = csw
  # b4
  ltra       = ltra
  txl        = txl
  cpl        = cpl
end

# devices and outputs (b4)
# Lossy and coupled lines. The element letter goes with the model: O for
# LTRA, Y for TXL, P for CPL (n inputs and their reference, then n outputs
# and theirs).
rule  lossyline[ltra] = name~"O" nodes+ master {...params}
rule  lossyline[txl]  = name~"Y" nodes+ master {...params}
rule  lossyline[cpl]  = name~"P" nodes+ master {...params}
# Controlled sources in POLY and TABLE form; checked to load in ngspice 45 (ESPice keeps ngspice's forms).
rule  ctlsrc    = name~"E" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"G" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"F" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"H" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"E" pos neg form:"table" expr "=" ( ~"(" xs ~"," ys ~")" )+
rule  ctlsrc    = name~"G" pos neg form:"table" expr "=" ( ~"(" xs ~"," ys ~")" )+
# Measurements in their common forms, so that the probes and numbers in
# them are translated; anything else is carried as text.
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"trig"=trig trig { val=trigval td=trigtd rise=trign@trigedge:rise fall=trign@trigedge:fall cross=trign@trigedge:cross } "targ" targ { val=targval td=targtd rise=targn@targedge:rise fall=targn@targedge:fall cross=targn@targedge:cross }
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"find"=find out "when" when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".meas" | ".measure" ) analysis name ( op:"find"=find | op:"deriv"=deriv ) out { at=at! }
rule  measure   = ( ".meas" | ".measure" ) analysis name ( op:"when"=when | op:"deriv"=deriv out "when" ) when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".meas" | ".measure" ) analysis name ( op:"avg"=avg | op:"rms"=rms | op:"max"=max | op:"min"=min | op:"pp"=pp | op:"integ"=integ ) out { from=from to=to }
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"param"=param ~"=" expr
rule  measure   = ( ".meas" | ".measure" ) analysis name spec...
caveat measure spec : carried as text: the probes, expressions and numbers in it were not translated
no relay  : ngspice has no relay element; a voltage-controlled switch (S) with a sw model is the closest form
no simctl : ESPice's own commands live in its .control block, which is kept as it is; there is no netlist statement for them
# sweeps
# .step repeats every analysis; .temp with three values is a sweep from the
# first to the second by the third.
define stepwhat = ( var:"temp" | "param" param | src )
rule  step      = ".step" <stepwhat> "list" ( values )+
rule  step      = ".step" <stepwhat> start stop step
rule  step      = var:".temp"=temp start stop step
rule  data      = ".data" name ( cols )+ ( values )* / ".enddata"
caveat data name : ESPice 0.3.0 takes a deck with .data for HSPICE unless run with --tokenizer ngspice, and HSPICE has no {} expressions
# Instance parameters each device takes, by canonical name (the ngspice one);
# the first spelling is written. As ngspice: `devhelp` in ngspice 45. One a
# netlist brings from another dialect that a table here lacks is a loss; a
# kind with no table is not checked.
params resistor
  same ac bv_max dtemp l m scale tc2 tce temp w
  tc1   = tc1 tc
  noisy = noisy noise
end
params capacitor
  same bv_max dtemp ic l m q scale tc1 tc2 temp w
end
params inductor
  same dtemp ic m nt scale tc1 tc2 temp
end
params isource
  same m r td
end
params diode
  same area dtemp ic l lm lp m off perim pj temp w wm wp
end
params bjt
  same area areab areac dtemp ic m off temp
end
params jfet
  same area dtemp ic m off temp
end
# alter (c2)
# ESPice reads HSPICE's .alter blocks: each reruns every analysis with its
# lines on top of those of the alters before it, as in HSPICE.
rule  alter     = ".alter" [name]
read  alter     = ".alter" ...
# topology (d1)
# Measured on decks written for it (ESPice, Nov 2026): a capacitor-only
# island makes the operating point, DC sweep and AC analysis refuse
# (FloatingNode); a transient solves it as ngspice does (0.25 V on a 1p:3p
# divider). An unbalanced current cutset is refused everywhere. A loop of
# voltage sources, consistent or not, or of a source and an inductor, is
# refused, even with UIC. One of inductors only is solved, the current
# split evenly whatever the inductances (ngspice splits 1u:3u otherwise).
requires dc-path   error   : ESPice's operating point, DC sweep and AC analysis refuse it (FloatingNode), where its transient and ngspice divide the charge among the capacitors
requires no-vloop  error   : ESPice refuses it
requires no-vlloop error   : ESPice refuses it, where ngspice gets through with its transient operating point
requires no-lloop  warning : ESPice solves it, but splits the current around the loop evenly whatever the inductances
