# Spectre (simulator lang=spectre)
#
# Case sensitive. SI scale factors, so M is mega and m is milli. `//` and a
# leading `*` are comments, `\` at the end of a line continues it.
# Expressions need no delimiters; `^` is exclusive-or and `**` is power. A
# device's type comes from its master, not from the first letter of its
# name, so transistors are read as generic instances and resolved against
# the models declared in the netlist (or in the rest of the project).
#
# The integration method is a parameter of the tran analysis here, not a
# global option; the `move` line carries it over in both directions.
#
# Not expressible in this grammar: `simulator lang=spice` sections, inline
# subckt, statistics blocks, and any analysis in the last opaque list that no
# rule above it reads. Such lines are kept verbatim for Spectre output and
# reported as errors for any other target.
#
# Checked by loading decks in Spectre 25.10: every rule below that writes a
# statement was run, and the expression and model tables were measured.

dialect spectre

lexer
  case       sensitive
  title      yes "// "
  comment    line "//" "*"
  comment    tail "//"
  continue   trail "\"
  parens     token
  expr       bare
  values     idents
  scale      M=6 T=12 G=9 k=3 K=3 m=-3 u=-6 n=-9 p=-12 f=-15 a=-18
  readscale  _=0 %=-2 c=-2
  units      after-scale
  numbers    strict           # version=3.3.0 does not load
end

# In every file, included ones too.
header
  simulator lang=spectre
end

# In the top netlist only.
preamble
  global 0
end

block subckt
  open   "subckt" name ["("] ports* [")"]
  inner  "parameters" {...params}
  close  "ends" [name]
end

# `if (c) { ... } else if (c) { ... } else { ... }`, the branches as markers.
block cond_if
  open   "if" "(" cond ")" "{"
  close  "}"
end

block libsection
  open   "section" name
  close  "endsection" [name]
end

rule  cond_elif = "}" "else" "if" "(" cond ")" "{"
rule  cond_else = "}" "else" "{"
rule  param     = "parameters" {...params}
rule  func      = "real" name ~"(" ( "real" args )*~"," ~")" "{" / "return" expr... / "}"
# The first node of each global statement is ground, so one more global
# node is written after 0, never on a line of its own.
rule  global    = "global" "0" nodes+
read  global    = "global" nodes+
rule  include   = "include" path
rule  lib       = "include" path { section=section }
rule  model     = "model" name type {...params}
rule  hdl       = "ahdl_include" path

rule  options   = _?sprackOptions$# "options" { reltol=reltol iabstol=abstol vabstol=vntol gmin=gmin temp=temp tnom=tnom scale=scale ...params }
rule  save      = "save" signals+
# No print statement: what a SPICE deck prints is saved instead.
write print     = "save" -style -analysis signals+
rule  ic        = "ic" { ...values }
rule  nodeset   = "nodeset" { ...values }

# Statements this grammar recognises but cannot express. Listing them keeps
# the generic instance rule at the bottom from misreading them.
read  opaque    = ( "save" | "ic" | "nodeset" | "simulator" | "statistics" | "library" | "endlibrary" | "real" ) ...
read  opaque    = _ ( "options" | "info" | "alter" | "altergroup" | "set" | "shell" | "paramset" | "check" | "checklimit" | "assert" ) ...

# A dc analysis that sweeps something is a DC sweep; any other is an
# operating point. It sweeps an instance (param= names what of it, the
# instance's own value when left out), the temperature or a parameter. lin=
# counts intervals, values= lists the points.
define dcline   = name?dc$# "dc" ( { dev=src! param=devparam start=start stop=stop step=step dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params } | { param==temp!@var:temp start=start stop=stop step=step dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params } | { param=param! start=start stop=stop step=step dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params } )
# A nested DC sweep is a sweep statement around the inner dc analysis. Read,
# that is a step around a dc, which is folded back into the dc's outer loop.
write dc        = _?sweep$# "sweep" ( { dev=src2! start=start2 stop=stop2 step=step2 dec=points2@sweep2:dec oct=points2@sweep2:oct lin=points2@sweep2:lin } | { param==temp!@var2:temp start=start2 stop=stop2 step=step2 dec=points2@sweep2:dec oct=points2@sweep2:oct lin=points2@sweep2:lin } | { param=param2! start=start2 stop=stop2 step=step2 dec=points2@sweep2:dec oct=points2@sweep2:oct lin=points2@sweep2:lin } ) "{" / <dcline> / "}"
rule  dc        = <dcline>
# SPICE's .sens runs its own operating point; here sens names the analysis.
rule  sens      = name?sens$# "dc" / "sens" "(" out ")" "for" "(" name?sens$# ")"
rule  op        = name?op$# "dc" {...params}
rule  ac        = name?ac$# "ac" { start=fstart stop=fstop dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params }
rule  tran      = name?tran$# "tran" { step=step stop=stop start=start maxstep=maxstep skipdc=skip_dc method=method ...params }
rule  noise     = name?noise$# "(" out ref?0 ")" "noise" { iprobe=src start=fstart stop=fstop dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params }
rule  stb       = name?stb$# "stb" { start=fstart stop=fstop dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin probe=probe! ...params }
rule  pss       = name?pss$# "pss" { fund=fund! harms=harms tstab=tstab ...params }
rule  sp        = name?sp$# "sp" { start=fstart stop=fstop dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin ...params }
# xf at one frequency, 0 Hz, is the DC transfer function. It is computed
# from every source at once, so the source is not named, and an xf read
# back names none: the form is write-only.
write tf        = name?xf$# "(" out ref?0 ")" "xf" -src { freq==0 ...params }
rule  pz        = name?pz$# "(" out "0" ")" "pz" { iprobe=src! ...params }
rule  hb        = name?hb$# "hb" { fundfreqs=[freqs]! maxharms=[harms] ...params }
# The Fourier analyser is an instance that watches one signal during tran.
rule  four      = name?four$# "(" signals#1 "0" ")" "fourier" { fund=freq! ...params }
# analyses (b3). Each was loaded in Spectre 25.10. A pac, pnoise or pxf
# follows a pss; hbac, hbnoise and hbxf follow an hb, and neither kind runs
# after the other's steady state. An input-referred pnoise needs refsideband.
rule  pac       = name?pac$# ( engine:"hbac"=hb | "pac" ) { start=fstart stop=fstop dec=points@sweep:dec lin=points@sweep:lin ...params }
rule  pnoise    = name?pnoise$# "(" out ref?0 ")" ( engine:"hbnoise"=hb | "pnoise" ) { iprobe=src! refsideband==0 start=fstart stop=fstop dec=points@sweep:dec lin=points@sweep:lin ...params }
rule  pnoise    = name?pnoise$# "(" out ref?0 ")" ( engine:"hbnoise"=hb | "pnoise" ) { start=fstart stop=fstop dec=points@sweep:dec lin=points@sweep:lin ...params }
rule  pxf       = name?pxf$# "(" out ref?0 ")" ( engine:"hbxf"=hb | "pxf" ) { start=fstart stop=fstop dec=points@sweep:dec lin=points@sweep:lin ...params }
# The ports and the harmonic each one is driven at (portharmsvec) are parameters.
rule  psp       = name?psp$# ( engine:"hbsp"=hb | "psp" ) { start=fstart stop=fstop dec=points@sweep:dec lin=points@sweep:lin ...params }
rule  xf        = name?xf$# "(" out ref?0 ")" "xf" { start=fstart stop=fstop dec=points@sweep:dec lin=points@sweep:lin ...params }
rule  dcmatch   = name?dcmatch$# "(" out ref?0 ")" "dcmatch" {...params}
rule  envelope  = name?envlp$# "envlp" { clockname="clock"! stop=stop ...params }
# The fundamentals are named; each source says which it drives (fundname=).
rule  qpss      = name?qpss$# "qpss" { funds=[funds]! maxharms=[harms] ...params }
read  opaque    = _ ["("] _* [")"] ( "pss" | "pac" | "pnoise" | "pxf" | "psp" | "hb" | "hbac" | "hbnoise" | "sp" | "xf" | "stb" | "pz" | "sens" | "dcmatch" | "montecarlo" | "sweep" | "envlp" | "qpss" ) ...

# With a model of its own the device keeps it; these forms are write-only
# because any two-terminal instance would match them when reading.
write resistor  = name "(" pos neg ")" master { r=r ...params }
write capacitor = name "(" pos neg ")" master { c=c ...params }
rule  resistor  = name ["("] pos neg [")"] "resistor" { r=r ...params }
rule  capacitor = name ["("] pos neg [")"] "capacitor" { c=c ...params }
rule  inductor  = name ["("] pos neg [")"] "inductor" { l=l ...params }
rule  mutual    = name "mutual_inductor" { coupling=k ind1=l1 ind2=l2 }
# type=dc is the default and says nothing; read it and move on.
read  vsource   = name ["("] pos neg [")"] "vsource" { type==dc dc=dc mag=acmag phase=acphase ...params }
read  isource   = name ["("] pos neg [")"] "isource" { type==dc dc=dc mag=acmag phase=acphase ...params }
rule  vsource   = name ["("] pos neg [")"] "vsource" { dc=dc mag=acmag phase=acphase type=wave val0=val0 val1=val1 delay=delay rise=rise fall=fall width=width period=period sinedc=sinedc ampl=ampl freq=freq damp=damp sinephase=sphase td1=td1 tau1=tau1 td2=td2 tau2=tau2 wave=[pwl] pacmag=pacmag fundname="fundname" ...params }
rule  isource   = name ["("] pos neg [")"] "isource" { dc=dc mag=acmag phase=acphase type=wave val0=val0 val1=val1 delay=delay rise=rise fall=fall width=width period=period sinedc=sinedc ampl=ampl freq=freq damp=damp sinephase=sphase td1=td1 tau1=tau1 td2=td2 tau2=tau2 wave=[pwl] pacmag=pacmag fundname="fundname" ...params }
rule  bsource   = name ["("] pos neg [")"] "bsource" { v=v i=i ...params }
rule  vcvs      = name ["("] pos neg cpos cneg [")"] "vcvs" { gain=gain }
rule  vccs      = name ["("] pos neg cpos cneg [")"] "vccs" { gm=gm }
rule  cccs      = name ["("] pos neg [")"] "cccs" { probe=vsrc gain=gain }
rule  ccvs      = name ["("] pos neg [")"] "ccvs" { probe=vsrc rm=gain }
rule  tline     = name ["("] p1 n1 p2 n2 [")"] "tline" { z0=z0 td=td f=f nl=nl ...params }
rule  vswitch   = name ["("] pos neg cpos cneg [")"] master { region=state! }
write vswitch   = name "(" pos neg cpos cneg ")" master
rule  cswitch   = name ["("] pos neg [")"] master { probe=vsrc! region=state }
# devices and outputs (b4)
# Each form below was loaded in Spectre 25.10.
rule  relay     = name ["("] pos neg cpos cneg [")"] "relay" {...params}
# A port is a source with a series resistance and a port number.
rule  vsource   = name ["("] pos neg [")"] "port" { num=portnum! r=z0 dc=dc mag=acmag phase=acphase type=wave val0=val0 val1=val1 delay=delay rise=rise fall=fall width=width period=period sinedc=sinedc ampl=ampl freq=freq damp=damp sinephase=sphase td1=td1 tau1=tau1 td2=td2 tau2=tau2 wave=[pwl] pacmag=pacmag fundname="fundname" ...params }
# A one-input polynomial is pvcvs or pvccs with the coefficients as a list.
# The master says which; a SPICE source says it by its letter, so these
# forms are written only.
write ctlsrc    = name~"E" "(" pos neg cpos#1 cneg#1 ")" form:"pvcvs"=poly -dim { coeffs=[coeffs]! }
write ctlsrc    = name~"G" "(" pos neg cpos#1 cneg#1 ")" form:"pvccs"=poly -dim { coeffs=[coeffs]! }
rule  instance  = name ["("] nodes+ [")"] master {...params}

move options.method -> tran.method
enum tran method : trap=trap gear=gear2 euler=euler
enum vsource wave : pulse=pulse sine=sine exp=exp pwl=pwl
enum isource wave : pulse=pulse sine=sine exp=exp pwl=pwl
implied noise ref = 0

no lossyline : this grammar has no form for Spectre's lossy lines; their models are not SPICE LTRA, TXL, CPL or RLGC cards
no simctl  : Spectre has no control commands of this kind; its analyses and options are netlist statements
no disto   : Spectre has no SPICE-style .DISTO analysis; distortion is found with pss/pac or hb
no measure : Spectre's own language has no measure statement; measurements are written in MDL or done in the waveform calculator
no xspice : XSPICE code models are ngspice's; this grammar has no form for them
no verilog : this grammar has no form that loads a digital Verilog design
# analyses (b3)
implied pnoise ref = 0
implied pxf ref = 0
implied xf ref = 0
implied dcmatch ref = 0
invalid psp params : Spectre's psp and hbsp stop without the ports and the harmonic each is driven at (ports=, portharmsvec=), which other dialects do not state
no trannoise  : Spectre runs transient noise as parameters of the tran analysis (noisefmax=, noiseseed=); this grammar has no form that puts the HSPICE card there
no phasenoise : Spectre finds oscillator phase noise with pnoise or hbnoise on an autonomous steady state; this grammar has no form that marks one apart

caveat tran skip_dc : skipdc=yes skips the DC solve and takes initial conditions from ic statements; SPICE UIC also honours ic= on devices
caveat tran method : the integration methods are near equivalents, not the same algorithm
caveat print signals : Spectre has no print statement; the signals are saved instead
caveat pac fstart : Spectre drives pac from each source's pacmag, not from the ac mag; a deck whose sources have no pacmag stops with an error
caveat tf src : xf gives the transfer function from every source, the named one among them; the input and output resistances are not reported
caveat hdl path : ahdl_include expects Verilog-A source, not a compiled OSDI file

# A pulse's rise and fall: Spectre refuses 0 and, left out, takes a default
# of its own far below the .tran step (observed on a deck written for it);
# SPICE means the .tran step by either, so that is written out.
default vsource rise=0 wave=pulse : tran.step
default isource rise=0 wave=pulse : tran.step
default vsource fall=0 wave=pulse : tran.step
default isource fall=0 wave=pulse : tran.step
invalid vsource rise=0 wave=pulse : Spectre refuses a zero rise time and, left out, takes its own small default; SPICE takes the time step
invalid isource rise=0 wave=pulse : Spectre refuses a zero rise time and, left out, takes its own small default; SPICE takes the time step
invalid vsource fall=0 wave=pulse : Spectre refuses a zero fall time and, left out, takes its own small default; SPICE takes the time step
invalid isource fall=0 wave=pulse : Spectre refuses a zero fall time and, left out, takes its own small default; SPICE takes the time step

signals
  i = "%:p"
  # b4: a terminal current, M1:d.
  ix = "%:%"
  v = "%"
end

functions
  same abs min max sqrt exp pow pwr floor ceil int nint sgn db sin cos tan asin acos atan atan2 sinh cosh tanh asinh acosh atanh hypot fmod v i
  sign2 = sign
  ln    = log
  log10 = log10
end

differs pow : a negative base with a fractional exponent stops the run instead of giving a value

variables
  temper = temp
end

operators
  pow "**"
  xor "^"
end

models
  resistor   = resistor
  capacitor  = capacitor
  inductor   = inductor
  diode      = diode
  bjt npn    = bjt type=npn
  bjt pnp    = bjt type=pnp
  vbic npn   = vbic type=npn
  vbic pnp   = vbic type=pnp
  jfet n     = jfet type=n
  jfet p     = jfet type=p
  mesfet n   = gaas type=n
  mesfet p   = gaas type=p
  mos1 n     = mos1 type=n
  mos1 p     = mos1 type=p
  mos2 n     = mos2 type=n
  mos2 p     = mos2 type=p
  mos3 n     = mos3 type=n
  mos3 p     = mos3 type=p
  bsim3 n    = bsim3v3 type=n
  bsim3 p    = bsim3v3 type=p
  bsim4 n    = bsim4 type=n
  bsim4 p    = bsim4 type=p
  bsimsoi n  = bsimsoi type=n
  bsimsoi p  = bsimsoi type=p
  bsimcmg n  = bsimcmg type=n
  bsimcmg p  = bsimcmg type=p
  bsimbulk n = bsimbulk type=n       # bsim6 is a second name for the same model
  bsimbulk p = bsimbulk type=p
  psp103 n   = psp103 type=n
  psp103 p   = psp103 type=p
  hisim2 n   = hisim2 type=n
  hisim2 p   = hisim2 type=p
  hisimhv n  = hisim_hv type=n
  hisimhv p  = hisim_hv type=p
  vswitch    = vswitch
  cswitch    = iswitch
end

# sweeps
# A sweep statement runs the analyses inside its braces once per point.
block step
  open   name?swp$# "sweep" ( { dev=src! param=devparam start=start stop=stop step=step dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params } | { param==temp!@var:temp start=start stop=stop step=step dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params } | { param=param! start=start stop=stop step=step dec=points@sweep:dec oct=points@sweep:oct lin=points@sweep:lin values=[values] ...params } ) "{"
  close  "}"
end
no data : this grammar has no form for Spectre's paramset tables, whose columns must be netlist parameters (a SPICE .data column may name a source)
# lin= counts intervals: lin=4 gives 5 points, where SPICE's LIN 4 gives 4.
convert dc sweep=lin : points = points - 1
convert dc sweep2=lin : points2 = points2 - 1
convert step sweep=lin : points = points - 1
convert ac sweep=lin : points = points - 1
convert noise sweep=lin : points = points - 1
convert sp sweep=lin : points = points - 1
convert stb sweep=lin : points = points - 1
# A sweep whose stop is its start is refused; its one point goes in values=.
convert dc stop==start : values = [stop]
convert ac fstop==fstart : values = [fstop]
convert noise fstop==fstart : values = [fstop]
# Instance parameters each device takes, by canonical (ngspice) name; the
# first spelling is written. Observed: a deck per name, a warning for one
# Spectre does not take; `m>0`: m of zero or less stops the run. A kind with
# no table is not checked.
params resistor
  same ac c l m>0 scale tc1 tc2 w
  dtemp = dtemp trise
  noisy = isnoisy
end
params capacitor
  same ic l m>0 q scale tc1 tc2 w
  dtemp = dtemp trise
end
params inductor
  same ic m>0 r tc1 tc2 temp
  dtemp = dtemp trise
end
params isource
  same m>0
end
params diode
  same area l lm lp m>0 perim pj w wm wp
  dtemp = dtemp trise
end
params bjt
  same area areab areac m>0
  dtemp = dtemp trise
end
params jfet
  same area l m>0 w
  dtemp = dtemp trise
end
