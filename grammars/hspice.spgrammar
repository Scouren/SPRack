# HSPICE
#
# Differences from ngspice captured here: `$` is the only trailing comment,
# single quotes are the only expression delimiters (braces are not), X is a
# second spelling of Meg, a bare identifier may be a value, .TRAN writes
# START= and reads more step and stop pairs as segments, user functions
# are .PARAM f(x)='...', behavioural sources are E and G elements with VOL=
# and CUR=, Verilog-A is loaded with .HDL and instantiated as X.
#
# Checked by loading decks in HSPICE Y-2026.03: every rule below that writes
# a statement was run, and the expression and model tables were measured.
#
# .NOISE rides on the .AC statement before it and has no sweep of its own.
# A noise analysis is therefore written as the two lines together. A .NOISE
# read takes its sweep from the .AC before it (`merge`), and is one statement
# with it when nothing but comments stands between them; otherwise the .AC
# stays an analysis in its own right.

dialect hspice

lexer
  case      insensitive
  title     yes
  comment   line "*"
  annotation "*@"          # a line a tool reads (cktImg's `*@ order m1 m2`), whole, in its scope
  comment   tail "$"
  continue  lead "+"
  continue  trail "\"                  # `\\` too: the lexer takes a doubled one
  parens    space
  expr      "'" "'"
  expr      after-equals       # .param a=agauss(0,1,3): a bare call after = is one value
  # "a^3" is the expression 'a^3' in .param, instance, model, source and
  # analysis values; .include, .lib, .option search and a .meas name keep
  # it a path or label, and rlgcfile= and tstonefile= a file name.
  quotes    '"' expr-in-values except rlgcfile tstonefile
  values    idents
  # The HSPICE User Guide's scale table: X is 1e6, A 1e-18, MIL 25.4e-6
  # (docs/verification.md 4.38; documented, not run).
  scale     meg=6 x=6 t=12 g=9 k=3 m=-3 u=-6 n=-9 p=-12 f=-15 a=-18
  oddscale  mil=25.4e-6
  units     ignore
  numbers   strict            # version=3.3.0 does not load
  end       ".end"
end

block subckt
  open   ".subckt" name ports* {...params} -inline -dirs
  close  ".ends" [name]
end

block libsection
  open   ".lib" name
  close  ".endl" [name]
end

block cond_if
  open   ".if" cond...
  close  ".endif"
end

rule  func      = ".param" name ~"(" args* ~")" "=" expr
rule  param     = ".param" {...params}
read  param     = ".parameters" {...params}
rule  cond_elif = ".elseif" cond...
rule  cond_else = ".else"
rule  global    = ".global" nodes+
rule  include   = ".include" path
read  include   = ".inc" path
rule  lib       = ".lib" path section
rule  model     = ".model" name type {...params}
rule  hdl       = ".hdl" path

rule  options   = ".temp" temp
rule  options   = ".option" { reltol=reltol relv=reltol reli=reltol+ abstol=abstol absi=abstol vntol=vntol absv=vntol gmin=gmin gmindc=gmin+ gmindc=gmindc tnom=tnom scale=scale method=method maxord=maxord chgtol=chgtol trtol=trtol gshunt=gshunt cshunt=cshunt delmax=delmax search=search ...params? }
read  options   = ".options" { reltol=reltol relv=reltol reli=reltol+ abstol=abstol absi=abstol vntol=vntol absv=vntol gmin=gmin gmindc=gmin+ gmindc=gmindc tnom=tnom scale=scale method=method maxord=maxord chgtol=chgtol trtol=trtol gshunt=gshunt cshunt=cshunt delmax=delmax search=search ...params? }
rule  print     = ( style:".print"=print | style:".plot"=plot | style:".probe"=probe ) [analysis] signals+
# HSPICE's own .SAVE stores an operating point; recording signals is .PROBE.
write save      = ".probe" signals+
rule  ic        = ".ic" { v(*)=values }
# .DCVOLT is .IC, also spelled with bare `node value` pairs.
read  ic        = ".dcvolt" { v(*)=values+ }
rule  nodeset   = ".nodeset" { v(*)=values }

# The model comes before the value; `R1 a b 1k rmod` does not load.
rule  resistor  = name~"R" pos neg [r] { r=r ...params }
rule  resistor  = name~"R" pos neg master [r] { r=r ...params }
rule  capacitor = name~"C" pos neg [c] { c=c ...params }
rule  capacitor = name~"C" pos neg master [c] { c=c ...params }
rule  inductor  = name~"L" pos neg [l] { l=l ...params }
rule  mutual    = name~"K" l1 l2 k
read  mutual    = name~"K" l1 l2 { k=k! }
# The waveform of a V or I source; vsource and isource share these slots.
define wave = ( wave:"pulse" ~"(" val0 val1 [delay [rise [fall [width [period]]]]] ~")" | wave:"sin"=sine ~"(" sinedc?$dc ampl [freq [delay [damp [sphase]]]] ~")" | wave:"exp" ~"(" val0 val1 [td1 [tau1 [td2 [tau2]]]] ~")" | wave:"pwl" ~"(" pwl+ ~")" | wave:"sffm" ~"(" sinedc ampl [freq [mdi [fsig]]] ~")" | wave:"am" ~"(" ampl val0 fsig freq [delay] ~")" | wave:"pat" ~"(" val1 val0 delay rise fall width bits+ ~")" )
# b4: `dc=` as a key, and `ac` with no magnitude, which is 1 (ngspice 45
# reads `ac` and `dc 0 ac` so: docs/verification.md 4.38). Tried first: a
# bare name is a value here, so the rule below would take `ac` for the DC
# value.
read  vsource   = name~"V" pos neg [ ( { dc=dc! } | "dc" dc ) ] [ ( "ac" acmag [acphase] | acmag:"ac"=1 ) ] [ <wave> ] {r=repeat ...params}
rule  vsource   = name~"V" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] {r=repeat ...params}
read  vsource   = name~"V" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] {r=repeat ...params}
read  vsource   = name~"V" pos neg "ac" acmag [acphase] "dc" dc {r=repeat ...params}
# A named pattern; a PAT source gives its name where the bits go.
rule  pattern   = ".pat" name ~"=" data...
read  isource   = name~"I" pos neg [ ( { dc=dc! } | "dc" dc ) ] [ ( "ac" acmag [acphase] | acmag:"ac"=1 ) ] [ <wave> ] {r=repeat ...params}
rule  isource   = name~"I" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] {r=repeat ...params}
read  isource   = name~"I" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] {r=repeat ...params}
read  isource   = name~"I" pos neg "ac" acmag [acphase] "dc" dc {r=repeat ...params}
rule  bsource   = name~"E" pos neg { vol=v! }
rule  bsource   = name~"G" pos neg { cur=i! }
rule  vcvs      = name~"E" pos neg cpos cneg gain
rule  vccs      = name~"G" pos neg cpos cneg gm
rule  cccs      = name~"F" pos neg vsrc gain
rule  ccvs      = name~"H" pos neg vsrc gain
rule  diode     = name~"D" pos neg master [area] { area=area ...params? }
rule  bjt       = name~"Q" c b e [s] master [area] { area=area ...params? }
# With a substrate node and a thermal node (self-heating models).
rule  bjt       = name~"Q" c b e s tj master [area] { area=area ...params? }
rule  mosfet    = name~"M" d g s b master {...params}
rule  jfet      = name~"J" d g s master [area] {...params}
# A MESFET is a J element whose model has a MESFET level; reading sorts the
# two apart by the model.
write mesfet    = name~"J" d g s master [area] {...params}
rule  tline     = name~"T" p1 n1 p2 n2 { z0=z0 td=td f=f nl=nl ...params }
rule  instance  = name~"X" nodes+ master {...params}

# `.op 1n 5n`: the operating point at these times of a transient run.
rule  op        = ".op" ( times )*
# `.dc monte=30`: a Monte Carlo of the operating point (the ending below).
read  op        = ".dc"
rule  tf        = ".tf" "v" ~"(" out [ ~"," ref ] ~")" src
rule  pz        = ".pz" out src
# What is swept: the temperature, a source or a parameter. The range is a
# step, points per decade or octave, points in all (LIN), or a list (POI,
# with the count first). A POI list is greedy when read, so the forms with a
# second sweep after it are tried first.
define what  = ( var:"temp" | src | param )
define what2 = ( var2:"temp" | src2 | param2 )
define range = ( ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points start stop | "poi" _?$+values ( values )+ | start stop step )
read  dc        = ".dc" <what> "poi" _ ( values )+ <what2> ( sweep2:"dec" | sweep2:"oct" | sweep2:"lin" ) points2 start2 stop2
read  dc        = ".dc" <what> "poi" _ ( values )+ <what2> start2 stop2 step2
rule  dc        = ".dc" <what> <range> [ <what2> ( ( sweep2:"dec" | sweep2:"oct" | sweep2:"lin" ) points2 start2 stop2 | start2 stop2 step2 ) ]
read  dc        = ".dc" <what> { start=start! stop=stop! step=step! }
rule  dc        = ".dc" { data=data! }
# A frequency sweep, or a list of frequencies (POI, the count first).
define freqs = ( ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop | "poi" _?$+values ( values )+ )
rule  ac        = ".ac" <freqs>
rule  tran      = ".tran" step?'$stop/1000' stop { start=start } [ skip_dc:"uic"=yes ]
# More step and stop pairs: one run to the last stop (read at the smallest
# step). Numbers that do not rise are SPICE's start time and step ceiling:
# measured, `.tran 1n 100n 90n` outputs from 90n and `.tran 1n 10n 0 1n`
# stops at 10n, while `.tran 1n 10n 2n 20n` runs to 20n.
read  tran      = ".tran" step stop ( segments )+ { start=start } [ skip_dc:"uic"=yes ]
write noise     = ".ac" <freqs> / ".noise" "v" ~"(" out [ ~"," ref ] ~")" src [interval]
read  noise     = ".noise" "v" ~"(" out [ ~"," ref ] ~")" src [interval]
merge ac -> noise
# S-parameters: .LIN over the .AC sweep, ports are P elements.
# Its parameters say what is computed and written (gdcalc=1: group delay).
write sp        = ".ac" <freqs> / ".lin" {...params}
read  sp        = ".lin" {...params}
merge ac -> sp
rule  pss       = ".sn" { tone=fund! nharms=harms trinit=tstab ...params }
# The period and the time resolution: NHARMS is round(PERIOD/TRES).
read  pss       = ".sn" { tres=tres! period=period! trinit=tstab ...params }
rule  sens      = ".sens" out
rule  four      = ".four" freq signals+
# The spectrum of a transient signal. Measured (docs/verification.md 4.32):
# each window below runs; another window, format or key is warned about
# and the statement dropped, so the table below lists every key.
rule  fft       = ".fft" out { start=start from=start stop=stop to=stop np=np window=window alfa=alfa format=format freq=freq fmin=fmin fmax=fmax ...params }
enum  fft window : rect=rect bart=bart hann=hann hamm=hamm black=black harris=harris gauss=gauss kaiser=kaiser
enum  fft format : norm=norm unorm=unorm
params fft
end
rule  hb        = ".hb" "tones" ~"=" ( freqs )+ [ "nharms" ~"=" ( harms )+ ] {...params}
read  hb        = ".hb" { tones=freqs! nharms=harms ...params }
# One tone and its harmonics, by position.
read  hb        = ".hb" freqs#1 harms#1 {...params}

# analyses (b3). Each was loaded in HSPICE Y-2026.03. The SN forms follow a
# .SN (pss), the HB forms a .HB.
rule  pac        = ( engine:".hbac"=hb | ".snac" ) ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
# The band the noise is referred to, a harmonic and a sideband, after the
# sweep; `0 1` is the output band itself, as without it.
read  pnoise     = ( engine:".hbnoise"=hb | ".snnoise" ) "v" ~"(" out [ ~"," ref ] ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop "0" [ "," ] "1"
read  pnoise     = ( engine:".hbnoise"=hb | ".snnoise" ) "v" ~"(" out [ ~"," ref ] ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop band#1 [ "," ] ( band )*
rule  pnoise     = ( engine:".hbnoise"=hb | ".snnoise" ) "v" ~"(" out [ ~"," ref ] ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop ( band )*
rule  pxf        = ( engine:".hbxf"=hb | ".snxf" ) "v" ~"(" out [ ~"," ref ] ~")" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
# S-parameters of the P ports around the .HB solution.
rule  psp        = engine:".hblin"=hb <freqs> {...params}
# Without a .VARIATION block HSPICE warns and has no mismatch to report.
rule  dcmatch    = ".dcmatch" "v" ~"(" out [ ~"," ref ] ~")"
# Runs on the deck's .TRAN.
rule  trannoise  = ".trannoise" "v" ~"(" out [ ~"," ref ] ~")" { method=method samples=samples seed=seed fmin=fmin fmax=fmax scale=scale time=time ...params }
rule  phasenoise = ".phasenoise" "v" ~"(" out [ ~"," ref ] ~")" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop {...params}
# .LSTB breaks the loop at a voltage source and sweeps over the .AC before it.
write stb        = ".ac" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop / ".lstb" { mode==single vsource=probe! ...params }
read  stb        = ".lstb" { mode==single vsource=probe! ...params }
merge ac -> stb
implied pnoise ref = 0
implied pxf ref = 0
implied dcmatch ref = 0
implied trannoise ref = 0
implied phasenoise ref = 0
no xf       : this grammar has no HSPICE form for an AC transfer-function sweep; .TF is the DC one
no tf iout  : this grammar has no HSPICE form for a current as the output of .TF; that HSPICE takes `.tf i(vm) vin` as ngspice does is not established without an HSPICE run (#56)
no envelope : this grammar has no form for HSPICE's envelope analyses (.ENV and its kin)
no qpss     : HSPICE has no shooting quasi-periodic analysis; a multitone .HB is its quasi-periodic steady state
# statistics
# A .VARIATION block varies model parameters: `nmos nch vth0=0.01` is an
# absolute sigma, `vth0=10 %` a relative one. A parameter of the netlist is
# varied with agauss() or aunif() in its .PARAM instead: Spectre's `vary x`
# is written that way when `x` is defined in the same file.
block statistics
  open   ".variation"
  close  ".end_variation"
end
# `.element_variation` varies every element of a type: `r r=10%` is each
# resistor's r with a sigma of 10 percent of its value.
block statgroup
  open   ( scope:".global_variation"=process | scope:".local_variation"=mismatch | scope:".element_variation"=element )
  close  ( scope:".end_global_variation"=process | scope:".end_local_variation"=mismatch | scope:".end_element_variation"=element )
end
rule  vary      = mtype model param ~"=" std [ rel:"%"=yes ]
# An element type and its parameter (in an .element_variation).
rule  vary      = mtype param ~"=" std [ rel:"%"=yes ]
no correlate : HSPICE has no statement that sets a correlation coefficient between two varied parameters; correlated variation comes from sharing one random variable
# A library file has no wrapper around its .LIB sections; the name is
# carried as a comment.
block library
  open   "*" "library" name
  close  "*" "endlibrary"
end
caveat library name : HSPICE has no library wrapper around .LIB sections; it is written as a comment
caveat subckt inline : HSPICE has no inline subcircuits; the subcircuit is written as an ordinary one, so the devices in it are named one level deeper
# A parameter's variation follows it on its own line as an entry of its
# own: `.param p=1 dev/gauss=0.1 lot/unif=0.05`. Another dialect gets a
# random function in the parameter's definition.
variation inline
# Monte Carlo is a sweep added to each analysis: `.tran 1n 1u sweep monte=30`.
spread montecarlo
rule  montecarlo = "sweep" "monte" ~"=" ~"list" ~"(" ( trials )+ ~")" -seed -runs
read  montecarlo = "sweep" "monte" ~"=" "list" ( trials )+
rule  montecarlo = "sweep" "monte" ~"=" runs -seed
# `.dc monte=30` (an operating point above).
read  montecarlo = "monte" ~"=" runs
# An optimization, the ending of the analysis it optimizes over:
# `.dc v1 0 5 1 sweep optimize=opt1 results=vout model=optmod`.
spread optimize
rule  optimize   = "sweep" "optimize" ~"=" param "results" ~"=" ( results )+~"," "model" ~"=" model
# `result=` in the singular, as the suite's optimize/bisection_divider.sp has it;
# not run in HSPICE (docs/verification.md 4.32).
read  optimize   = "sweep" "optimize" ~"=" param "result" ~"=" ( results )+~"," "model" ~"=" model
own model "opt" : HSPICE's optimizer is set by a .MODEL of type OPT; no other dialect has an optimizer statement for it to drive
implied montecarlo variations = all
no montecarlo variations : an HSPICE Monte Carlo run varies every random parameter, global and local alike; it cannot vary one kind alone
caveat montecarlo seed : HSPICE takes the Monte Carlo seed from .OPTION SEED, which is not written

implied tf ref = 0
implied noise ref = 0
# What an EXP source means by a value left out, measured in HSPICE
# Y-2026.03-SP2-1 (docs/verification.md 4.18): TD1 is 0, TAU1 half of what
# is left of the run after TD1, and without a TD2 the source does not fall
# within the run; TAU2 is half of what is left after TD2. The print step
# plays no part.
implied vsource td1 = 0 wave=exp
implied isource td1 = 0 wave=exp
omitted vsource tau1 wave=exp : (tran.stop - td1) / 2
omitted isource tau1 wave=exp : (tran.stop - td1) / 2
omitted vsource td2 wave=exp : tran.stop
omitted isource td2 wave=exp : tran.stop
omitted vsource tau2 wave=exp : (tran.stop - td2) / 2 given td2
omitted isource tau2 wave=exp : (tran.stop - td2) / 2 given td2
# Measured in HSPICE Y-2026.03 (docs/verification.md 4.7). BDF is a method
# of its own: an LC tank it damps far less than GEAR, so its canonical name
# is bdf, which the other dialects write as their gear.
enum options method : trap=trap gear=gear bdf=bdf
caveat read options method=*bdf : HSPICE's BDF is not its GEAR: on an LC tank run 100 periods at 20 steps a period it kept 0.78 of the swing where GEAR kept 0.005; the target's gear damps as GEAR does
# ABSV is VNTOL, ABSI is ABSTOL and RELV is RELTOL: each pair gave the same
# result to ten digits. RELTOL bounds voltages only; RELI bounds currents.
# GMINDC acts in DC and the operating point only, GMIN in the transient
# only. ngspice, Xyce, Spectre and VACASK have one reltol for both and one
# gmin for both, so another dialect's reltol and gmin are written here as
# both keys (`+`).
caveat read options reltol : HSPICE's RELTOL (RELV) bounds node voltages only and RELI branch currents; the target's reltol bounds both
caveat read options gmin : HSPICE's GMIN acts in the transient only, not in its operating point; the target's gmin acts in DC too
caveat read options gmindc : HSPICE's GMINDC acts in DC and the transient's operating point only; it is the target's gmin, which acts through the transient too
inert options post : HSPICE's POST only picks the waveform file written; no result depends on it
enum dc var : temp=temp
# Measured in HSPICE Y-2026.03 with a 1k resistor of tc1=0.01: TNOM is 25,
# and with no .TEMP the circuit runs at TNOM (.OPTION TNOM=0 ran it at 0).
implied options tnom = 25
implied options temp = $tnom

no vswitch : HSPICE has no S switch element; a voltage-controlled resistor (G element, VCR) is the closest form
no cswitch : HSPICE's W element is a transmission line; there is no current-controlled switch
no disto   : HSPICE's .DISTO measures distortion power into a named load resistor; the SPICE form has no load resistor to name
no xspice : XSPICE code models are ngspice's; this grammar has no form for them
no verilog : HSPICE co-simulates no Verilog module in a netlist
inert ports : in {to} the top level of a netlist has no ports; they are those of the module structural Verilog makes of it

# Observed on decks written for it (Y-2026.03): an island reached only
# through capacitors is solved and left at 0 V, where ngspice divides the
# charge (0.5 V on an equal capacitive divider); an unbalanced current
# source into one drives it to about 1e9 V. A loop of voltage sources, of
# a voltage source and an inductor, or of inductors only stops the run.
# The User Guide says the same: topology rules 1 and 2, the inductor/voltage
# source loop error, and a node with no DC path tied to ground through
# GDCPATH with a warning (docs/verification.md 4.38).
requires dc-path   warning [op dc ac noise tf pz sens disto sp stb xf dcmatch hb pss pac pnoise pxf psp qpss phasenoise tran trannoise envelope] : HSPICE solves it but starts such nodes at 0 V, where ngspice divides the charge among the capacitors
requires no-vloop  error   : HSPICE stops on it
requires no-vlloop error   : HSPICE stops on it, where ngspice gets through with its transient operating point
requires no-lloop  error   : HSPICE stops on it, where ngspice and Xyce solve it

caveat tran skip_dc : UIC skips the DC solve and starts from .IC and IC= values; other simulators seed the first time point differently
# The step is capped by .OPTION DELMAX; a fourth .TRAN number below the stop
# changes nothing (measured: docs/verification.md 4.18), so the cap is said
# as the option. One option holds for every .TRAN of the netlist.
move tran.maxstep -> options.delmax oneway
caveat noise src : HSPICE runs noise as part of an AC analysis, so the AC analysis itself is run as well
caveat hdl path=*.osdi : .HDL expects Verilog-A source, not a compiled OSDI file
caveat save signals : HSPICE's own .SAVE stores an operating point; the signals are recorded with .PROBE

# How this dialect writes the things a simulator can record.
signals
  vdiff = "v(%,%)"
  v     = "v(%)"
  i     = "i(%)"
  vdb   = "vdb(%)"
  vm    = "vm(%)"
  vp    = "vp(%)"
  vr    = "vr(%)"
  vi    = "vi(%)"
  # b4
  idb   = "idb(%)"
  ip    = "ip(%)"
  im    = "im(%)"
  ir    = "ir(%)"
  ii    = "ii(%)"
  expr  = "par('%')"
end
functions
  same abs min max sqrt exp pow pwr floor ceil int sgn sin cos tan asin acos atan sinh cosh tanh
  same agauss gauss aunif unif v i
  same nint db atan2 hypot fmod asinh
  ln    = log
  log10 = log10
  sign2 = sign
end

differs pow  : the exponent is cut to an integer first, so pow(2,2.5) and 2**2.5 are 4
differs nint : halves round away from zero (nint(2.5) is 3), not to even
differs ln   : a negative argument gives -ln|x| instead of an error: log(-2) is -0.693
differs log10 : a negative argument gives -log10|x| instead of an error: log10(-100) is -2
# pwr keeps the sign of a negative base: pwr(-2,2) is -4 (docs/verification.md 4.3).
means pwr(x, y) = sign2(pow(abs(x),y),x)

variables
  same temper time hertz
end

# Measured: a unary ! loads ('1k*(!0)' is 1k); '10 % 3' is refused.
operators
  pow "**" "^"
  ternary "?"
  not "!"
end

models
  resistor   = r
  capacitor  = c
  inductor   = l
  diode      = d
  bjt npn    = npn
  bjt pnp    = pnp
  vbic npn   = npn level=4
  vbic pnp   = pnp level=4
  hicum2 npn = npn level=8
  hicum2 pnp = pnp level=8
  jfet n     = njf
  jfet p     = pjf
  mos1 n     = nmos level=1 | nmos !level
  mos1 p     = pmos level=1 | pmos !level
  mos2 n     = nmos level=2
  mos2 p     = pmos level=2
  mos3 n     = nmos level=3
  mos3 p     = pmos level=3
  # The Star-HSPICE manual's MOSFET chapter: level 13 is BSIM, 39 BSIM2.
  bsim1 n    = nmos level=13
  bsim1 p    = pmos level=13
  bsim2 n    = nmos level=39
  bsim2 p    = pmos level=39
  bsim3 n    = nmos level=49 | nmos level=53
  bsim3 p    = pmos level=49 | pmos level=53
  bsim4 n    = nmos level=54
  bsim4 p    = pmos level=54
  bsimsoi n  = nmos level=70 | nmos level=57
  bsimsoi p  = pmos level=70 | pmos level=57
  bsimcmg n  = nmos level=72
  bsimcmg p  = pmos level=72
  bsimbulk n = nmos level=77
  bsimbulk p = pmos level=77
  psp103 n   = nmos level=69
  psp103 p   = pmos level=69
  hisim2 n   = nmos level=68
  hisim2 p   = pmos level=68
  hisimhv n  = nmos level=73
  hisimhv p  = pmos level=73
  mesfet n   = njf level=3
  mesfet p   = pjf level=3
  # b4
  rlgc       = w modeltype=rlgc
end

# devices and outputs (b4)
# Each form below was loaded in HSPICE Y-2026.03.
# The lossy and coupled line is the W element with an RLGC model; there is
# no O (LTRA), Y (TXL) or P (CPL) line.
rule  lossyline[rlgc] = name~"W" nodes+ { rlgcmodel=master! ...params }
# A port for .LIN: a source in series with z0.
# A third node: a balanced port, its legs against that reference.
rule  vsource   = name~"P" pos neg [ portref ] { port=portnum! z0=z0 dc=dc ac=acmag ...params } [ <wave> ]
rule  ctlsrc    = name~"E" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"G" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"F" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"H" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"E" pos neg form:"laplace" cpos#1 cneg#1 coeffs+ "/" den+
rule  ctlsrc    = name~"G" pos neg form:"laplace" cpos#1 cneg#1 coeffs+ "/" den+
rule  ctlsrc    = name~"E" pos neg form:"pole" cpos#1 cneg#1 gain ( zr ~"," zi )* "/" gain2 ( pr ~"," pi )*
rule  ctlsrc    = name~"G" pos neg form:"pole" cpos#1 cneg#1 gain ( zr ~"," zi )* "/" gain2 ( pr ~"," pi )*
rule  ctlsrc    = name~"G" pos neg form:"vcr" cpos#1 cneg#1 gain
rule  ctlsrc    = name~"G" pos neg form:"vccap" cpos#1 cneg#1 gain
# Measurements in their common forms, so that the probes and numbers in
# them are translated; anything else is carried as text. A measurement that
# names no analysis is of the last analysis in the netlist (the .MEASURE
# reference: "HSPICE uses the last analysis mode that you requested";
# docs/verification.md 4.38, documented, not run).
rule  measure   = ( ".meas" | ".measure" ) [analysis] name op:"trig"=trig trig { val=trigval td=trigtd rise=trign@trigedge:rise fall=trign@trigedge:fall cross=trign@trigedge:cross } "targ" targ { val=targval td=targtd rise=targn@targedge:rise fall=targn@targedge:fall cross=targn@targedge:cross }
rule  measure   = ( ".meas" | ".measure" ) [analysis] name op:"find"=find out "when" when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross ...params }
rule  measure   = ( ".meas" | ".measure" ) [analysis] name ( op:"find"=find | op:"deriv"=deriv | op:"derivative"=deriv ) out { at=at! ...params }
rule  measure   = ( ".meas" | ".measure" ) [analysis] name ( op:"when"=when | op:"deriv"=deriv out "when" | op:"derivative"=deriv out "when" ) when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".meas" | ".measure" ) [analysis] name ( op:"avg"=avg | op:"rms"=rms | op:"max"=max | op:"min"=min | op:"pp"=pp | op:"integ"=integ | op:"integral"=integ ) out { from=from to=to ...params }
rule  measure   = ( ".meas" | ".measure" ) [analysis] name op:"param"=param ~"=" expr
# The spectrum measurements (on an .FFT or a transient), each of a signal:
# `.meas tran thd1 thd v(out)`, `.meas fft s1 snr v(out) binsiz=1`.
rule  measure   = ( ".meas" | ".measure" ) [analysis] name ( op:"thd"=thd | op:"snr"=snr | op:"sndr"=sndr | op:"enob"=enob | op:"sfdr"=sfdr ) out {...params}
# `goal=` (an optimization's target) and the rest of a form's keys are
# its parameters. What none of the forms above reads, such as an analysis
# output keyword (`find phnoise at=10k`), is carried as text.
rule  measure   = ( ".meas" | ".measure" ) analysis name spec...
caveat measure spec : carried as text: the probes, expressions and numbers in it were not translated
# HSPICE's AM is sa*(oc + sin(2 pi fm t)) sin(2 pi fc t): no offset, and
# oc is the modulation offset over the modulation amplitude. That is the
# User Guide's formula (docs/verification.md 4.38; documented, not run).
convert vsource wave=am : val0 = val0 / ampl
convert isource wave=am : val0 = val0 / ampl
no relay  : HSPICE has no relay element; a voltage-controlled resistor (G element, VCR) is the closest form
no simctl : HSPICE has no control language besides its dot commands
# sweeps
# .TEMP with several values runs every analysis at each of them.
rule  step      = var:".temp"=temp ( values )+
# SWEEP at the end of an analysis line repeats that analysis alone:
# `.tran 1n 1u sweep rl 1k 10k 1k`, `.ac ... sweep temp poi 3 0 27 85`,
# `sweep data=rows`. Each loaded in HSPICE Y-2026.03 with the expected runs.
spread step "sweep"
rule  step      = "sweep" <what> <range>
rule  step      = "sweep" { data=data! }
rule  data      = ".data" name ( cols )+ ( values )* / ".enddata"
# Rows from files: `.data rows LAM FILE='l1.dat' rl=1 ... .enddata`.
rule  data      = ".data" name ( join:"lam" | join:"mer" ) files... / ".enddata"
# Instance parameters each device takes, by canonical (ngspice) name; the
# first spelling is written. Observed: a deck per name, a warning or an
# error for one HSPICE does not take (mosfet: levels 54 and 72 together).
# `m>0`: m of zero or less stops the run. A kind with no table is not checked.
params resistor
  same ac c dtemp l m>0 scale tc2 w
  tc1   = tc1 tc
  noisy = noise
end
params capacitor
  same dtemp ic l m>0 q scale tc1 tc2 w
end
params inductor
  same dtemp ic m>0 nt r scale tc1 tc2
end
params isource
  same m>0 td
end
params diode
  same area dtemp ic l lm lp m>0 mult off perim pj w wm wp
end
params bjt
  same area areab areac dtemp ic m>0 mult off
end
params jfet
  same area dtemp ic l m>0 off w
end
params mosfet
  same acnqsmod ad adeo as aseo d delvto dtemp factuo fpitch geomod ic l lrsd m>0 min mult mulu0
  same nf nfin ngcon nrd nrs off pd pdeo ps pseo rbdb rbodymod rbpb rbpd rbps rbsb
  same rgatemod rgeomod sa sb sc sca scb scc sd tfin trnqsmod w xgw
  # PSP's own name for the instance's temperature offset (level 69 takes dtemp, not dta).
  dta = dtemp
end
# What .LIN takes (HSPICE's .LIN reference); a parameter of another
# dialect's S-parameter analysis has no place on it.
params sp
  same dataformat filename format gdcalc mixedmode2port modelcalc noisecalc sparcalc
end
# alter (c2)
# Each .alter reruns every analysis with its lines on top of those of the
# alters before it: parameters, elements (changed or new), .temp, .lib
# sections and models, measured in HSPICE Y-2026.03. Its title is a label;
# one of several words is not kept.
rule  alter     = ".alter" [name]
read  alter     = ".alter" ...

# A model card's parameters that were measured, by ngspice name. A resistor's
# DW and DLR, with RSH=1000 at five L and W (docs/verification.md 4.13):
# ngspice's NARROW and SHORT, each taken off twice. NARROW and SHORT
# themselves are ignored here with a warning. Where W - 2 DW is 0 the
# resistance is a floor value with a warning, where ngspice is open.
modelparams resistor
  narrow = dw
  short  = dlr
end
computes resistor narrow short : R = RSH (L - 2 DLR) / (W - 2 DW)
edge resistor narrow : where W - 2 DW is 0, HSPICE takes a floor resistance (1e5 A at 1 V) with a warning, where ngspice and Spectre leave the resistor open (docs/verification.md 4.13)
# Statements of HSPICE's own that no kind holds: written elsewhere, each is
# an `unsupported` with the reason. The other dialects' references were read
# for each (docs/verification.md 4.32).
own ".connect" : HSPICE's .CONNECT makes two nets one; SPRack has no kind for it, and in the other dialects the same circuit is one of the nodes renamed to the other (or a 0 V source between them)
own "S*" : an HSPICE S element is an S-parameter block read from its .MODEL's TSTONEFILE; SPRack has no kind for it (Spectre's nport file= and Xyce's YLIN with a LIN model are the nearest forms)
own ".dcsens" : HSPICE's .DCSENS (DC mismatch sensitivity) is not mapped: its reference makes it a finite difference over the .VARIATION block, not .SENS's normalized derivatives, and no other dialect's form of it is known
own ".acmatch" : HSPICE's .ACMATCH (AC mismatch) is not mapped: SPRack has no kind for an AC mismatch analysis
own ".net" : HSPICE's .NET (network parameters over an .AC) is not mapped: SPRack has no kind for it (LTspice's .NET is a different statement)
own ".power" : HSPICE's .POWER (the power of each instance) is an output request SPRack has no kind for
own ".check" ".dout" ".biaschk" : HSPICE's timing, output and bias checks have no kind in SPRack; Spectre's checks (check, checklimit, assert) are not mapped either
own ".mosra" ".appendmodel" : HSPICE's MOSRA reliability (aging) analysis and its model appending have no form in the other dialects
own ".ptdnoise" ".sample" ".acphasenoise" : HSPICE's time-domain periodic noise, sampling noise and AC phase noise have no kind in SPRack
own ".load" : HSPICE's .LOAD reads an operating point HSPICE saved (.SAVE); the file is HSPICE's own format
own ".vec" : HSPICE's .VEC reads digital vectors from a file in HSPICE's own vector format
# Families ngspice has that HSPICE has no model of, or none known (#48);
# a run is #56's to make.
no model mos6 : HSPICE's level 6 is Lattin-Jenkins-Grove with ASPEC parasitics (its MOSFET Models manual), not SPICE3's MOS6
no model mos9 : HSPICE's MOS9 (level 50) is Philips MOS9, not SPICE3's modified level 3
no model b3soifd : HSPICE's level table has no fully depleted BSIM3SOI (its level 57 is the partially depleted one, and it lists no level 56); that a level takes ngspice's B3SOIFD 2.1 cards is not established without an HSPICE run (#56)
no model b3soidd : HSPICE's level table has no dynamically depleted BSIM3SOI (its level 57 is the partially depleted one, and it lists no level 56); that a level takes ngspice's B3SOIDD 2.1 cards is not established without an HSPICE run (#56)
no model b3soipd : HSPICE's level 57 (BSIM3SOI, UCB PD 2.2.3 at VERSION=2.2 by its MOSFET Models manual) is read here as bsimsoi; that it takes ngspice's B3SOIPD 2.2.3 cards is not established without an HSPICE run (#56)
no model mesa : HSPICE's MESFETs are J elements (level 3); none is the MESA model
no model urc : HSPICE's U element is a lossy transmission line of its own models; that HSPICE takes an ngspice URC line and card is not established without an HSPICE run (#56)
no script : HSPICE has no control script; its analyses and outputs are netlist lines
no csparam : only a control script reads a .csparam vector, and hspice has none
no native : the statement is another dialect's own, which no kind holds; only that dialect writes it
no embed : VACASK embeds a file (a post-processing script) in the netlist; this dialect has no such statement, so save the file next to the netlist
