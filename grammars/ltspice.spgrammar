# LTspice
#
# Checked against LTspice 26.0.2 run in batch mode on decks written for the
# check (docs/verification.md, section 8): every table below, the statements
# under `no`, the source waveforms and the topologies under `requires`.
# Not checked: the instance parameters of devices other than sources. The MOS
# levels other than 1, 2, 3, 8, 14, 49 and 54 are placed by the parameter
# names they know (section 8.12), and are not in the models table.
#
# Differences from ngspice captured here: `;` is the only trailing comment,
# there is no atto suffix, sources write their waveform before the AC spec
# and the sine is spelled SINE, `**` is power and `^` is exclusive-or, a
# minus binds before `**`, the logical operators are `&` and `|`, and the
# simulator variables are `temp` and `time`. A pulse needs four values. There
# are no .if blocks, no Verilog-A, and no pole-zero, sensitivity, distortion,
# harmonic balance, periodic steady state, S-parameter or loop-stability
# analyses.

dialect ltspice

lexer
  case      insensitive
  title     yes
  comment   line "*"
  comment   tail ";"
  continue  lead "+"
  parens    space
  expr      "{" "}"
  expr      after-equals         # .param s = 2 * 3 t = 5 and V=v(a) * 2 + 1 load
  values    strict
  scale     meg=6 t=12 g=9 k=3 m=-3 u=-6 n=-9 p=-12 f=-15
  oddscale  mil=25.4e-6
  units     ignore
  end       ".end"
end

block subckt
  open   ".subckt" name ports* ( {...params} | "params:" {...params} ) -inline
  close  ".ends" [name]
end

# A section is found only in a file loaded by section: `.lib name` in a deck
# or in a file loaded whole is taken for a file name. So the line opens a
# section only where an .endl follows it; elsewhere it loads a whole file.
block libsection
  open   ".lib" name
  close  ".endl" [name]
  closed
end

rule  func      = ".func" name ~"(" args* ~")" expr
rule  param     = ".param" {...params}
rule  global    = ".global" nodes+
rule  include   = ".include" path
read  include   = ".inc" path
# The path is quoted: without quotes the section is read as part of the name.
rule  lib       = ".lib" path section
# With no section, the whole file.
read  include   = ".lib" path
rule  model     = ".model" name type {...params?}

rule  options   = ".temp" temp
rule  options   = ".options" { reltol=reltol abstol=abstol vntol=vntol gmin=gmin tnom=tnom method=method maxord=maxord chgtol=chgtol trtol=trtol ...params? }
read  options   = ".option" { reltol=reltol abstol=abstol vntol=vntol gmin=gmin tnom=tnom method=method maxord=maxord chgtol=chgtol trtol=trtol ...params? }
rule  save      = ".save" signals+
rule  ic        = ".ic" { v(*)=values }
rule  nodeset   = ".nodeset" { v(*)=values }
# The forms ngspice has load here with the same results; any other is text.
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"trig"=trig trig { val=trigval td=trigtd rise=trign@trigedge:rise fall=trign@trigedge:fall cross=trign@trigedge:cross } "targ" targ { val=targval td=targtd rise=targn@targedge:rise fall=targn@targedge:fall cross=targn@targedge:cross }
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"find"=find out "when" when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"find"=find out { at=at! }
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"when"=when when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".meas" | ".measure" ) analysis name ( op:"avg"=avg | op:"rms"=rms | op:"max"=max | op:"min"=min | op:"pp"=pp | op:"integ"=integ ) out { from=from to=to }
rule  measure   = ( ".meas" | ".measure" ) analysis name op:"param"=param ~"=" expr
rule  measure   = ( ".meas" | ".measure" ) analysis name spec...
caveat measure spec : carried as text: the probes, expressions and numbers in it were not translated

rule  resistor  = name~"R" pos neg r {...params}
rule  capacitor = name~"C" pos neg c {...params}
rule  inductor  = name~"L" pos neg l {...params}
rule  mutual    = name~"K" l1 l2 k
# The waveform of a V or I source; vsource and isource share these slots.
define wave = ( wave:"pulse" ~"(" val0 val1 delay?0 rise [fall [width [period [count]]]] ~")" | wave:"sine"=sine ~"(" sinedc?$dc ampl freq [delay [damp [sphase [count]]]] ~")" | wave:"sin"=sine ~"(" sinedc?$dc ampl freq [delay [damp [sphase [count]]]] ~")" | wave:"exp" ~"(" val0 val1 [td1 [tau1 [td2 [tau2]]]] ~")" | wave:"pwl" ~"(" pwl+ ~")" | wave:"sffm" ~"(" sinedc ampl [freq [mdi [fsig]]] ~")" )
# A DC value next to a waveform is the value of the operating point; the
# transient starts from the waveform. A pulse of fewer than four values is
# refused, and a sine without a frequency is a constant, so both are required.
# A sine's seventh value is a number of cycles, counted from the delay; after
# them the source stays where the last cycle ended. 0 or none: no end. A
# pulse's eighth is its number of pulses, as in ngspice.
rule  vsource   = name~"V" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] {...params}
read  vsource   = name~"V" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] {...params}
rule  isource   = name~"I" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] {...params}
read  isource   = name~"I" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] {...params}
rule  bsource   = name~"B" pos neg { v=v i=i ...params }
read  bsource   = name~"E" pos neg { value=v! }
read  bsource   = name~"G" pos neg { value=i! }
rule  vcvs      = name~"E" pos neg cpos cneg gain
rule  vccs      = name~"G" pos neg cpos cneg gm
rule  cccs      = name~"F" pos neg vsrc gain
rule  ccvs      = name~"H" pos neg vsrc gain
rule  diode     = name~"D" pos neg master [area] { area=area ...params? }
rule  bjt       = name~"Q" c b e [s] master [area] { area=area ...params? }
rule  mosfet    = name~"M" d g s b master {...params}
# Three-terminal power MOSFETs (VDMOS) have no bulk node.
rule  mosfet    = name~"M" d g s master {...params}
rule  jfet      = name~"J" d g s master [area] {...params}
rule  mesfet    = name~"Z" d g s master [area] {...params}
rule  vswitch   = name~"S" pos neg cpos cneg master [ ( state:"on" | state:"off" ) ]
rule  cswitch   = name~"W" pos neg vsrc master [ ( state:"on" | state:"off" ) ]
rule  tline     = name~"T" p1 n1 p2 n2 { zo=z0 td=td ...params }
read  tline     = name~"T" p1 n1 p2 n2 { z0=z0 td=td ...params }
read  instance  = name~"X" nodes+ master "params:" {...params}
# devices and outputs (b4)
rule  lossyline[ltra] = name~"O" nodes+ master {...params}
rule  ctlsrc    = name~"E" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"G" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"F" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"H" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
no relay  : LTspice has no relay element; a voltage-controlled switch (S) is the closest form
no simctl : LTspice has no control language besides its dot commands
rule  instance  = name~"X" nodes+ master {...params}

rule  op        = ".op"
rule  tf        = ".tf" "v" ~"(" out [ ~"," ref ] ~")" src
rule  dc        = ".dc" var:"temp" start stop step
rule  dc        = ".dc" src start stop step [ src2 start2 stop2 step2 ]
rule  ac        = ".ac" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  tran      = ".tran" step?'$stop/1000' stop [ start?0 [maxstep] ] [ skip_dc:"uic"=yes ]
# One number is the stop time.
read  tran      = ".tran" stop [ skip_dc:"uic"=yes ]
rule  noise     = ".noise" "v" ~"(" out [ ~"," ref ] ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  four      = ".four" freq signals+
# .print and .plot load and write nothing; .probe is refused.
rule  print     = ( style:".print"=print | style:".plot"=plot ) [analysis] signals+
caveat print style : LTspice reads the line and prints nothing; every node is in the .raw file

# A deck holds one analysis: a second of .dc, .ac, .tran, .noise and .tf, the
# same one again or another, is refused and nothing runs. One .op loads beside
# one of them and is then not run: the operating point is in the .op.raw file
# of an analysis that starts from one (not .dc, not a .tran with UIC). .four,
# .meas, .step, .temp and .net do not count (docs/verification.md, 8.7).
unique analysis dc ac tran noise tf beside op : LTspice refuses a deck with more than one analysis ("More than one analysis specified."), unless there are two and one is .op, which it then does not run on its own

# What a source takes besides its values. A PWL is repeated by words of its
# own (PWL REPEAT FOREVER (...) ENDREPEAT), which this grammar does not write:
# `r=` is refused on a voltage source and is a load resistance on a current
# source, which then does not repeat, and `td=` is refused on both.
params vsource
  same rser cpar
end
params isource
  same load
end

implied noise ref = 0
implied tf ref = 0
# Every run's log states both.
implied options tnom = 27
implied options temp = 27
# No step-cap option: HSPICE's DELMAX is the tran maximum step (ngspice.spgrammar).
move options.delmax -> tran.maxstep oneway
# A zero rise or fall time is a tenth of the pulse width here, the .tran step
# in SPICE; with a fall time and no width the pulse does not stay up.
default vsource rise=0 wave=pulse : tran.step
default isource rise=0 wave=pulse : tran.step
default vsource fall=0 wave=pulse : tran.step
default isource fall=0 wave=pulse : tran.step
default vsource width=0 wave=pulse : tran.stop
default isource width=0 wave=pulse : tran.stop
# What an EXP source leaves out is 0 in LTspice 26.0.2 (measured): TD1 0;
# TAU1 0, an instant rise; TD2 0, so the fall starts with the rise; TAU2 0,
# an instant fall. ngspice 45 and Xyce 7.10 take the time step for TAU1 and
# TAU2 and TD1 plus the step for TD2; for TD1 ngspice takes the step, Xyce 0.
implied vsource td1 = 0 wave=exp
implied isource td1 = 0 wave=exp
invalid vsource tau1 wave=exp : LTspice's default rise time constant is 0, an instant rise; ngspice's and Xyce's is the time step
invalid isource tau1 wave=exp : LTspice's default rise time constant is 0, an instant rise; ngspice's and Xyce's is the time step
invalid vsource td2 wave=exp : LTspice's default TD2 is 0, so the fall starts with the rise; ngspice's and Xyce's is TD1 plus the time step
invalid isource td2 wave=exp : LTspice's default TD2 is 0, so the fall starts with the rise; ngspice's and Xyce's is TD1 plus the time step
invalid vsource tau2 wave=exp : LTspice's default fall time constant is 0, an instant fall; ngspice's and Xyce's is the time step
invalid isource tau2 wave=exp : LTspice's default fall time constant is 0, an instant fall; ngspice's and Xyce's is the time step
invalid vsource rise=0 wave=pulse : LTspice takes a tenth of the pulse width for a zero rise time and refuses a pulse without one; SPICE takes the time step
invalid isource rise=0 wave=pulse : LTspice takes a tenth of the pulse width for a zero rise time and refuses a pulse without one; SPICE takes the time step
enum options method : trap=trap gear=gear
enum dc var : temp=temp

no pz        : LTspice has no pole-zero analysis
no sens      : LTspice has no .SENS sensitivity analysis
no disto     : LTspice has no .DISTO small-signal distortion analysis
no hb        : LTspice has no harmonic-balance analysis
no pss       : LTspice has no periodic steady-state analysis; .tran's steady modifier only stops at steady state
no sp        : LTspice has no .SP analysis; its .NET computes network parameters from an .AC analysis
no stb       : LTspice has no loop-stability analysis
no hdl       : LTspice cannot load Verilog-A
no device    : LTspice cannot instantiate a Verilog-A module
no cond_if   : LTspice has no conditional netlist blocks; use if() in an expression
no cond_elif : LTspice has no conditional netlist blocks; use if() in an expression
no cond_else : LTspice has no conditional netlist blocks; use if() in an expression
no xspice : XSPICE code models are ngspice's; LTspice's A devices are its own digital primitives with fixed pins
# analyses (b3)
no pac        : LTspice has no periodic steady-state analysis
no pnoise     : LTspice has no periodic steady-state analysis
no pxf        : LTspice has no periodic steady-state analysis
no psp        : LTspice has no periodic steady-state analysis
no xf         : LTspice has no AC transfer-function sweep
no dcmatch    : LTspice has no DC mismatch analysis
no trannoise  : LTspice has no transient-noise analysis card
no phasenoise : LTspice has no oscillator phase-noise analysis
no envelope   : LTspice has no envelope-following analysis
no qpss       : LTspice has no quasi-periodic steady-state analysis

# Topologies, as LTspice 26.0.2 treats them (docs/verification.md, 8.5).
requires dc-path   warning [op dc ac noise tf pz sens disto sp stb xf dcmatch hb pss pac pnoise pxf psp qpss phasenoise tran trannoise envelope] : LTspice solves it with a warning that the node is floating and holds the node near 0 V, where ngspice divides the charge among the capacitors
requires cutset    error   [op dc ac noise tf pz sens disto sp stb xf dcmatch hb pss pac pnoise pxf psp qpss phasenoise tran trannoise envelope] : LTspice logs an error and solves on: the source's current flows through gmin, 1 mA making 1e9 V
requires no-vloop  error   : LTspice stops on voltage sources in parallel, equal or not
requires no-vlloop warning : LTspice solves it by giving the inductor 1 milliohm in series: 1 V around the loop drives 1000 A
requires no-lloop  warning : LTspice solves it by giving each inductor 1 milliohm in series, which divides the current instead of the inductances

caveat tran skip_dc : UIC skips the DC solve and starts from .ic values; other simulators seed the first time point differently

# statistics
# LTspice has gauss(sigma) and mc(value, tolerance) and none of agauss(),
# aunif() and unif().
no statistics : LTspice has no statistics block; a parameter varies through gauss() or mc() in its definition
no statgroup : LTspice has no statistics block; a parameter varies through gauss() or mc() in its definition
no vary : LTspice has no statistics block; a parameter varies through gauss() or mc() in its definition
no correlate : LTspice has no statement that correlates two random parameters
no montecarlo : LTspice has no Monte Carlo statement; a run is a .step over a dummy parameter with mc() or gauss() in the values
# A library file has no wrapper around its sections; the name is carried
# as a comment.
block library
  open   "*" "library" name
  close  "*" "endlibrary"
end
caveat library name : LTspice has no library wrapper around its sections; it is written as a comment
caveat subckt inline : LTspice has no inline subcircuits; the subcircuit is written as an ordinary one, so the devices in it are named one level deeper

signals
  vdiff = "v(%,%)"
  v     = "v(%)"
  i     = "i(%)"
end

functions
  same abs min max sqrt exp pow pwr floor ceil int sgn sin cos tan asin acos atan sinh cosh tanh
  same limit atan2 hypot asinh acosh atanh uramp if v i
  ln    = ln log
  log10 = log10
  stp   = u stp
  nint  = round
end
differs nint : halves round away from zero (round(2.5) is 3), not to even
differs pwr  : the sign of a negative base is dropped: pwr(-2,3) is 8
means pwr(x, y) = pow(abs(x),y)
differs minuspow : a minus binds before the power: -2**2 is 4, not -4
differs andor : LTspice has no && and ||; its & and | are the logical operators, of one precedence, taken from the left

variables
  temper = temp
  same time
end

operators
  pow "**"
  xor "^"
  not "!"
  mod "%"
end

models
  diode      = d
  bjt npn    = npn
  bjt pnp    = pnp
  jfet n     = njf
  jfet p     = pjf
  mesfet n   = nmf
  mesfet p   = pmf
  mos1 n     = nmos level=1 | nmos !level
  mos1 p     = pmos level=1 | pmos !level
  mos2 n     = nmos level=2
  mos2 p     = pmos level=2
  mos3 n     = nmos level=3
  mos3 p     = pmos level=3
  bsim3 n    = nmos level=8 | nmos level=49
  bsim3 p    = pmos level=8 | pmos level=49
  bsim4 n    = nmos level=14 | nmos level=54
  bsim4 p    = pmos level=14 | pmos level=54
  vdmos      = vdmos
  vswitch    = sw
  cswitch    = csw
  ltra       = ltra
end

# sweeps
# .step repeats every analysis; .temp with several values runs each at every one.
define what = ( var:"temp" | "param" param | src )
rule  step      = ".step" ( sweep:"dec" | sweep:"oct" ) <what> start stop points
rule  step      = ".step" <what> "list" ( values )+
rule  step      = ".step" <what> start stop step
rule  step      = var:".temp"=temp ( values )+
no data : LTspice has no .data tables; .step lists values with list
# alter (c2)
no alter : LTspice has no .alter; a rerun with other values is a .step
no pattern : LTspice has no pattern sources; a bit pattern is a PWL
no fft : LTspice takes the FFT of a trace in its waveform viewer; no netlist statement asks for one
no optimize : LTspice has no optimizer statement
