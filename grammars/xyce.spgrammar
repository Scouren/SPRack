# Xyce
#
# From the Xyce Reference Guide and Sandia report SAND2018-14272 (HSPICE to
# Xyce translation). `;` is the trailing comment, braces delimit
# expressions, there is no `a` (atto) scale factor, subcircuit parameters
# follow PARAMS:, options are filed under a package name, and results exist
# only for what .PRINT lists. BSIM3 is level 9 or 49, BSIM4 14 or 54,
# BSIM-CMG 110, PSP 103.

dialect xyce

lexer
  case      insensitive
  title     yes
  comment   line "*"
  comment   tail ";"
  continue  lead "+"
  parens    space
  expr      "{" "}"
  quotes    '"' string           # .param t="a*3", r1 n 0 "2*rv" and r="2*rv" are refused
  values    strict
  scale     meg=6 t=12 g=9 k=3 m=-3 u=-6 n=-9 p=-12 f=-15
  oddscale  mil=25.4e-6
  units     ignore
  end       ".end"
end

block subckt
  open   ".subckt" name ports* [ "params:" {...params} ] -inline
  close  ".ends" [name]
end

# An instance sets only what the header declares. Given on an instance, a
# .param inside the subcircuit is taken, and kept for the later instances
# that give none (Xyce 7.10); ngspice 45 and LTspice 26.0.2 take it for that
# instance alone, as they do a header parameter (docs/verification.md 4.14).
hoist param from ngspice ltspice

block libsection
  open   ".lib" name
  close  ".endl" [name]
end

rule  param     = ".param" {...params}
read  param     = ".global_param" {...params}
# The arguments need their commas: ngspice and Xyce reject `g(x y)`.
rule  func      = ".func" name ~"(" ( args )*~"," ~")" expr
rule  global    = ".global" nodes+
rule  include   = ".include" path
read  include   = ".inc" path
rule  lib       = ".lib" path section
rule  model     = ".model" name type {...params}

# One heading per statement. A heading in the source is kept; options that
# come from another dialect are filed where Xyce wants them.
rule  options   = ".options" package:"timeint"? { reltol=reltol abstol=abstol method=method maxord=maxord ...params }
rule  options   = ".options" package:"device"? { gmin=gmin gmin=gmindc temp=temp tnom=tnom ...params }
rule  options   = ".options" package:"parser"? { scale=scale ...params }
rule  options   = ".options" package {...params}
rule  print     = style:".print"=print analysis {...params} signals+
rule  ic        = ".ic" { v(*)=values }
rule  nodeset   = ".nodeset" { v(*)=values }

rule  resistor  = name~"R" pos neg [r] [master] { r=r ...params }
rule  capacitor = name~"C" pos neg [c] [master] { c=c ...params }
rule  inductor  = name~"L" pos neg [l] { l=l ...params }
# The model may come before the value or after it, and the value after the
# model may be `l=`; a line with a model and no value does not load.
rule  inductor  = name~"L" pos neg master l {...params}
read  inductor  = name~"L" pos neg [l] master { l=l ...params }
rule  mutual    = name~"K" l1 l2 k
# The waveform of a V or I source; vsource and isource share these slots.
# Xyce requires FREQ in SIN(); ngspice defaults it to 1/tstop, which a source
# line cannot say here, so a SIN without it is not written.
define wave = ( wave:"pulse" ~"(" val0 val1 [delay [rise [fall [width [period]]]]] ~")" | wave:"sin"=sine ~"(" sinedc?$dc ampl freq [delay [damp [sphase]]] ~")" | wave:"exp" ~"(" val0 val1 [td1 [tau1 [td2 [tau2]]]] ~")" | wave:"pwl" ~"(" pwl+ ~")" | wave:"sffm" ~"(" sinedc ampl [freq [mdi [fsig]]] ~")" )
rule  vsource   = name~"V" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] {...params}
read  vsource   = name~"V" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] {...params}
read  vsource   = name~"V" pos neg "ac" acmag [acphase] "dc" dc {...params}
rule  isource   = name~"I" pos neg [ ["dc"] dc ] [ "ac" acmag [acphase] ] [ <wave> ] {...params}
read  isource   = name~"I" pos neg [ ["dc"] dc ] [ <wave> ] [ "ac" acmag [acphase] ] {...params}
read  isource   = name~"I" pos neg "ac" acmag [acphase] "dc" dc {...params}
rule  bsource   = name~"B" pos neg { v=v i=i ...params }
rule  bsource   = name~"E" pos neg { value=v! }
rule  bsource   = name~"G" pos neg { value=i! }
rule  vcvs      = name~"E" pos neg cpos cneg gain
rule  vccs      = name~"G" pos neg cpos cneg gm
rule  cccs      = name~"F" pos neg vsrc gain
rule  ccvs      = name~"H" pos neg vsrc gain
# A bare area after the model is read; area= is written, because ngspice 45
# takes `D1 a k dm 2` for a diode with a thermal node and rejects it, and
# Xyce rejects a bare area followed by named parameters.
read  diode     = name~"D" pos neg master area { area=area ...params? }
rule  diode     = name~"D" pos neg master { area=area ...params? }
# HICUM/L2 (level 234) always has a substrate and a thermal node; a SPICE
# deck may give three or four. The missing ones are ground and a node of
# the instance's own.
write bjt[hicum2] = name~"Q" c b e s?0 tj?dt$name master [area] { area=area ...params? }
rule  bjt       = name~"Q" c b e [s] master [area] { area=area ...params? }
# With a substrate node and a thermal node (self-heating models).
rule  bjt       = name~"Q" c b e s tj master [area] { area=area ...params? }
rule  mosfet    = name~"M" d g s b master {...params}
rule  jfet      = name~"J" d g s master [area] {...params}
rule  mesfet    = name~"Z" d g s master [area] {...params}
rule  vswitch   = name~"S" pos neg cpos cneg master [ ( state:"on" | state:"off" ) ]
rule  cswitch   = name~"W" pos neg vsrc master [ ( state:"on" | state:"off" ) ]
rule  tline     = name~"T" p1 n1 p2 n2 { z0=z0 td=td f=f nl=nl ...params }
# A port for .LIN: a voltage source in series with z0 (P_Device.tex).
rule  vsource   = name~"P" pos neg [ ["dc"] dc ] { port=portnum! z0=z0 } [ "ac" acmag [acphase] ] [ <wave> ]
rule  instance  = name~"X" nodes+ master [ "params:" {...params} ]

rule  op        = ".op"
# What is swept: the temperature, a source, a resistor or a parameter. LIN
# (the default) takes a step; DEC and OCT points per decade or octave; LIST
# the values (DC_Command.tex).
define what  = ( var:"temp" | src | param )
define what2 = ( var2:"temp" | src2 | param2 )
# The second sweep has the same forms, without a list.
define outer = [ ( ( sweep2:"dec" | sweep2:"oct" ) <what2> start2 stop2 points2 | <what2> start2 stop2 step2 ) ]
rule  dc        = ".dc" ( sweep:"dec" | sweep:"oct" ) <what> start stop points <outer>
rule  dc        = ".dc" "list" <what> ( values )+ <outer>
rule  dc        = ".dc" { data=data! }
rule  dc        = ".dc" <what> start stop step <outer>
read  dc        = ".dc" "lin" <what> start stop step <outer>
# S-parameters: .LIN extracts them at the frequencies of the .AC line, from
# the P (port) devices (LIN_Command.tex, P_Device.tex).
rule  sp        = ".ac" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop / ".lin" {...params}
rule  ac        = ".ac" ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  tran      = ".tran" step?'$stop/1000' stop [ start?0 [maxstep] ] [ skip_dc:"uic"=yes ]
# Xyce 7.10 documents V(out,ref) but its parser mistakes the comma form for
# other fields ("Cannot convert 'tox' to integer for expression
# PTS_PER_SUMMARY") or crashes, even for V(out,0); only V(out) works.
rule  noise     = ".noise" "v" ~"(" out ~")" src ( sweep:"dec" | sweep:"oct" | sweep:"lin" ) points fstart fstop
rule  four      = ".four" freq signals+
rule  hb        = ".hb" freqs+

implied noise ref = 0
# What an EXP source leaves out, measured with `.tran 2n 50n` (Xyce 7.10):
# TD1 is 0, TAU1 and TAU2 the step, TD2 TD1 plus the step. ngspice 45 is the
# same but for TD1, the step there, as in ESPice (Conformance Suite,
# netlist/tran/source_exp_defaults_ngspice).
implied vsource td1 = 0 wave=exp
implied isource td1 = 0 wave=exp
default vsource td1 wave=exp : tran.step from ngspice espice
default isource td1 wave=exp : tran.step from ngspice espice
enum options method : trap=trap gear=gear trap=7 gear=8 bdf=gear
enum dc var : temp=temp

no cond_if : Xyce has no conditional blocks in a netlist
no cond_elif : Xyce has no conditional blocks in a netlist
no cond_else : Xyce has no conditional blocks in a netlist
# No .PSS among the dot commands of src/IOInterfacePKG (docs/verification.md section 2).
no pss    : Xyce has no periodic steady-state (shooting) analysis; its periodic analyses are .HB and .MPDE
no tf     : Xyce has no .TF small-signal transfer function analysis
no pz     : Xyce has no pole-zero analysis
no disto  : Xyce has no .DISTO small-signal distortion analysis
no stb    : Xyce has no loop-stability analysis
no sens   : Xyce's .SENS takes an objective function and a parameter list, not an output variable
no save   : Xyce records only what .PRINT lists, and .PRINT needs an analysis type that a bare save does not give
no hdl    : Xyce loads Verilog-A models as compiled plugins named on the command line, not from the netlist
no device : Xyce instantiates a Verilog-A model through its compiled plugin's own device letter and level; there is no netlist form for an arbitrary module
no xspice : XSPICE code models are ngspice's; Xyce's digital devices are U and Y elements of their own
no verilog : Xyce has no netlist card that loads a digital Verilog design
# analyses (b3)
no pac        : Xyce's periodic analyses (.HB, .MPDE) have no small-signal analyses on top
no pnoise     : Xyce's periodic analyses (.HB, .MPDE) have no small-signal analyses on top
no pxf        : Xyce's periodic analyses (.HB, .MPDE) have no small-signal analyses on top
no psp        : Xyce's periodic analyses (.HB, .MPDE) have no small-signal analyses on top
no xf         : Xyce has no AC transfer-function sweep
no dcmatch    : Xyce has no DC mismatch analysis
no trannoise  : Xyce has no transient-noise analysis card
no phasenoise : Xyce has no oscillator phase-noise analysis
no envelope   : Xyce has no envelope-following analysis
no qpss       : Xyce has no quasi-periodic steady-state analysis; a multitone .HB is the closest

# Observed on decks written for it (Xyce 7.10): an island reached only
# through capacitors is solved with a warning (0.5 V on an equal
# capacitive divider, as ngspice); an unbalanced current source into one
# fails the operating point. A loop of voltage sources, or of a voltage
# source and an inductor, fails it; one of inductors only is solved.
requires dc-path   warning [op dc ac noise tf pz sens disto sp stb xf dcmatch hb pss pac pnoise pxf psp qpss phasenoise tran trannoise envelope] : Xyce solves it with a warning, but fails the operating point when the currents of sources into it do not balance
requires no-vloop  error   : Xyce's operating point fails on it
requires no-vlloop error   : Xyce's operating point fails on it, where ngspice gets through with its transient operating point
requires no-lloop  warning : Xyce solves it, but the current around the loop is not set by the circuit

caveat tran skip_dc : UIC (or NOOP) skips the DC solve; other simulators seed the first time point differently
caveat tran step : the first .TRAN number only sets the initial step in Xyce
caveat noise out : Xyce reports noise as mean-square densities where HSPICE reports RMS
caveat options gmin : Xyce adds GMIN differently from ngspice, which puts it across every junction; with a large GMIN the operating point differs (sim check: op/option_gmin_ngspice)
caveat options gmindc : Xyce adds GMIN differently from ngspice, which puts it across every junction; with a large GMIN the operating point differs (sim check: op/option_gmin_ngspice)
caveat nodeset values : Xyce and ngspice apply nodesets with different algorithms; a circuit with several operating points may settle in another one (sim check: op/nodeset_latch)

# How this dialect writes the things a simulator can record.
# A parameter of one of these names is refused: Xyce keeps them for its
# own variables (the thermal voltage, temperature, time, frequency, gmin).
reserved vt temp time freq gmin : Xyce keeps this name for a variable of its own and refuses a parameter called so

# statistics
# A parameter of the netlist varies through agauss(), gauss(), aunif() or unif() in its
# definition; a statistics block's process variations are written that way
# when the varied parameter is defined in the same file.
no statistics : Xyce has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no statgroup : Xyce has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no vary : Xyce has no statistics block; a parameter varies through agauss(), gauss(), aunif() or unif() in its definition
no correlate : Xyce has no statement that correlates two random parameters
# Monte Carlo over the expressions that call agauss() and its kin: every
# analysis of the netlist is run once per sample.
rule  montecarlo = ".sampling" "useexpr" ~"=" "true" / ".options" "samples" { numsamples=runs! seed=seed ...params }
# A library file has no wrapper around its sections; the name is carried
# as a comment.
block library
  open   "*" "library" name
  close  "*" "endlibrary"
end
caveat library name : Xyce has no library wrapper around its sections; it is written as a comment
caveat subckt inline : Xyce has no inline subcircuits; the subcircuit is written as an ordinary one, so the devices in it are named one level deeper

signals
  vdiff = "v(%,%)"
  v     = "v(%)"
  i     = "i(%)"
  vdb   = "vdb(%)"
  vm    = "vm(%)"
  vp    = "vp(%)"
  vr    = "vr(%)"
  vi    = "vi(%)"
  # b4
  idb   = "idb(%)"
  ip    = "ip(%)"
  im    = "im(%)"
  ir    = "ir(%)"
  ii    = "ii(%)"
  ix    = "i%2(%1)"
end
functions
  same abs min max sqrt exp pow pwr floor ceil int sgn sin cos tan asin acos atan sinh cosh tanh
  same limit agauss gauss aunif unif v i
  same nint atan2 asinh acosh atanh stp uramp fmod db
  # LOG is base 10 unless Xyce runs with -hspice-ext math
  # (ExpressionParser.yxx:1424-1446; Expression_Arithmetic_Functions.tex:205).
  ln    = ln
  log10 = log10 log
  sign2 = sign
  if    = if
end

variables
  temper = temp
  time   = time
  hertz  = freq
end

# `^` is boolean XOR unless Xyce runs with -hspice-ext math
# (ExpressionParser.yxx:1783-1792; Expression_Operator.tex:29,35).
operators
  pow "**"
  xor "^"
  ternary "?"
end

# Measured with Xyce 7.10 on decks written for it.
differs pwr    : pwr(x,y) is pow(x,y) here: pwr(-2,2) is 4, where HSPICE and Spectre keep the sign (-4)
differs nint   : halves round away from zero (nint(2.5) is 3), not to even
differs log10  : a negative argument is taken by its magnitude: log10(-100) is 2, an error elsewhere

models
  resistor   = r
  capacitor  = c
  inductor   = l | ind
  diode      = d
  # Q levels: 1 Gummel-Poon, 11/12 VBIC, 23 FBH, 230/234 HICUM, 504/505 MEXTRAM (N_DEV_BJT.C:4705).
  bjt npn    = npn !level | npn level=1
  bjt pnp    = pnp !level | pnp level=1
  # VBIC 1.3: 11 is 3-terminal, 12 is 4-terminal (deviceFeatureSupportTbl.tex:64-68).
  vbic npn   = npn level=11 | npn level=12
  vbic pnp   = pnp level=11 | pnp level=12
  hicum2 npn = npn level=234
  hicum2 pnp = pnp level=234
  jfet n     = njf
  jfet p     = pjf
  mesfet n   = nmf
  mesfet p   = pmf
  mos1 n     = nmos level=1 | nmos !level
  mos1 p     = pmos level=1 | pmos !level
  mos2 n     = nmos level=2
  mos2 p     = pmos level=2
  mos3 n     = nmos level=3
  mos3 p     = pmos level=3
  bsim3 n    = nmos level=9 | nmos level=49
  bsim3 p    = pmos level=9 | pmos level=49
  bsim4 n    = nmos level=14 | nmos level=54
  bsim4 p    = pmos level=14 | pmos level=54
  bsimsoi n  = nmos level=70 | nmos level=10 | nmos level=57
  bsimsoi p  = pmos level=70 | pmos level=10 | pmos level=57
  # 111 is BSIM-CMG 111.2.1; 110 "has been superceded" (M_Device.tex:865,891).
  bsimcmg n  = nmos level=111 | nmos level=110 | nmos level=108 | nmos level=107
  bsimcmg p  = pmos level=111 | pmos level=110 | pmos level=108 | pmos level=107
  bsimbulk n = nmos level=77
  bsimbulk p = pmos level=77
  psp103 n   = nmos level=103
  psp103 p   = pmos level=103
  # N_DEV_SW.C:1089-1092 registers only switch, iswitch and vswitch; there is no sw or csw.
  vswitch    = vswitch
  cswitch    = iswitch
  # b4
  ltra       = ltra
end

# SPICE gives a switch threshold and hysteresis (VT VH, IT IH); Xyce gives
# the levels where it is fully on and fully off (S_Device.tex: VON VOFF, ION
# IOFF), and VT/VH are ignored with a warning. on = vt + vh, off = vt - vh.
threshold vswitch : von voff = vt vh
threshold cswitch : ion ioff = it ih
# devices and outputs (b4)
# The lossy line is an O element with an LTRA model; Xyce has no TXL, CPL
# or RLGC line model (no such device in its parser).
rule  lossyline[ltra] = name~"O" nodes+ master {...params}
# POLY and TABLE controlled sources; checked to load in Xyce 7.10.
rule  ctlsrc    = name~"E" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"G" pos neg form:"poly" ~"(" dim?1 ~")" ( cpos cneg )#dim coeffs+
rule  ctlsrc    = name~"F" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"H" pos neg form:"poly" ~"(" dim?1 ~")" vsrcs#dim coeffs+
rule  ctlsrc    = name~"E" pos neg form:"table" expr "=" ( ~"(" xs ~"," ys ~")" )+
rule  ctlsrc    = name~"G" pos neg form:"table" expr "=" ( ~"(" xs ~"," ys ~")" )+
# Measurements in their common forms, so that the probes and numbers in
# them are translated; anything else is carried as text.
# Xyce gives the threshold after the signal (trig v(b)=0.2), not as val= (checked in Xyce 7.10).
rule  measure   = ( ".measure" | ".meas" ) analysis name op:"trig"=trig trig ~"=" trigval { td=trigtd rise=trign@trigedge:rise fall=trign@trigedge:fall cross=trign@trigedge:cross } "targ" targ ~"=" targval { td=targtd rise=targn@targedge:rise fall=targn@targedge:fall cross=targn@targedge:cross }
read  measure   = ( ".measure" | ".meas" ) analysis name op:"trig"=trig trig { val=trigval td=trigtd rise=trign@trigedge:rise fall=trign@trigedge:fall cross=trign@trigedge:cross } "targ" targ { val=targval td=targtd rise=targn@targedge:rise fall=targn@targedge:fall cross=targn@targedge:cross }
rule  measure   = ( ".measure" | ".meas" ) analysis name op:"find"=find out "when" when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".measure" | ".meas" ) analysis name ( op:"find"=find | op:"deriv"=deriv ) out { at=at! }
rule  measure   = ( ".measure" | ".meas" ) analysis name ( op:"when"=when | op:"deriv"=deriv out "when" ) when ~"=" whenval { td=whentd rise=whenn@whenedge:rise fall=whenn@whenedge:fall cross=whenn@whenedge:cross }
rule  measure   = ( ".measure" | ".meas" ) analysis name ( op:"avg"=avg | op:"rms"=rms | op:"max"=max | op:"min"=min | op:"pp"=pp | op:"integ"=integ ) out { from=from to=to }
rule  measure   = ( ".measure" | ".meas" ) analysis name op:"param"=param ~"=" expr
rule  measure   = ( ".measure" | ".meas" ) analysis name spec...
caveat measure spec : carried as text: the probes, expressions and numbers in it were not translated
no relay  : Xyce has no relay element; a voltage-controlled switch (S) with a vswitch model is the closest form
no simctl : Xyce has no control language besides its dot commands

# sweeps
# .STEP repeats every analysis of the netlist (STEP_Command.tex).
rule  step      = ".step" ( sweep:"dec" | sweep:"oct" ) <what> start stop points
# A list names the swept thing first (`.step rv list 1k 3k`), unlike .DC's.
rule  step      = ".step" <what> "list" ( values )+
read  step      = ".step" "list" <what> ( values )+
rule  step      = ".step" { data=data! }
rule  step      = ".step" <what> start stop step
read  step      = ".step" "lin" <what> start stop step
rule  data      = ".data" name ( cols )+ ( values )* / ".enddata"
# Instance parameters each device takes, by canonical (ngspice) name; the
# first spelling is written. From `Xyce -param` (7.10), all levels of a
# device together; `m>0`: zero or less is a netlist error. A kind with no
# table is not checked.
params resistor
  same dtemp l m>0 tc1 tc2 tce temp w
end
params capacitor
  same dtemp ic l m>0 q tc1 tc2 temp w
end
params inductor
  same dtemp ic m>0 tc1 tc2 temp
end
params isource
  same r td
end
params diode
  same area dtemp ic m mult off perim pj temp
end
params bjt
  same area dtemp m mult off temp
end
params jfet
  same area dtemp temp
end
# alter (c2)
no alter : Xyce has no .alter; when every alter changes only parameters and the temperature the runs are written as a .step over a .data table, a row per run

# Measured with a 1k resistor of tc1=0.01: 27 each, and independent.
implied options tnom = 27
implied options temp = 27

# A resistor model's NARROW and SHORT, measured with RSH=1000 at five L and W
# (docs/verification.md 4.13).
computes resistor narrow short : R = RSH (L - NARROW) / (W - NARROW), with no SHORT (a warning, and it is ignored); its NARROW = n is NARROW = SHORT = n/2 of a model that takes each off twice
